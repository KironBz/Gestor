@page "/movimientos"
@using YESSMobilePWA.Models
@using YESSMobilePWA.Services
@using YESSMobilePWA.Components
@using Microsoft.AspNetCore.Components.Forms
@inject ArchivoService ArchivoService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<h3>Movimientos</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="() => AbrirModal()">Agregar movimiento</button>
</div>

<!-- ===================== FILTROS ===================== -->
<!-- Botón para mostrar/ocultar filtros (solo en móvil) -->
<div class="mb-2 text-end d-md-none">
    <button class="btn btn-sm btn-outline-light" @onclick="ToggleFiltros">
        @(mostrarFiltros ? "Ocultar filtros" : "Mostrar filtros")
        @if (HayFiltrosActivos())
        {
            <span class="badge bg-primary ms-1">!</span>
        }
    </button>
</div>

<!-- Panel de filtros: en móvil se oculta/muestra; en escritorio siempre visible -->
<div class="card bg-dark text-white mb-3 @(mostrarFiltros ? "" : "d-none d-md-block")">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0">Filtros</h6>
            <button class="btn btn-sm btn-outline-light" @onclick="LimpiarFiltros">Limpiar filtros</button>
        </div>
        <div class="row g-2">
            <div class="col-md-3">
                <label class="form-label small">Buscar (descripción / referencia / meta)</label>
                <input type="text" class="form-control form-control-sm" placeholder="Ej. renta, PR-..."
                       value="@filtroTexto" @oninput="OnFiltroTextoChanged" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Tipo</label>
                <select class="form-select form-select-sm" value="@filtroTipo" @onchange="OnFiltroTipoChanged">
                    <option value="">Todos</option>
                    <option value="Ingreso">Ingreso</option>
                    <option value="Egreso">Egreso</option>
                    <option value="Transferencia">Transferencia</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Cuenta</label>
                <select class="form-select form-select-sm" value="@filtroCuentaId" @onchange="OnFiltroCuentaChanged">
                    <option value="">Todas</option>
                    @foreach (var cuenta in cuentasDisponibles)
                    {
                        <option value="@cuenta.Id">@cuenta.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Categoría</label>
                <select class="form-select form-select-sm" value="@filtroCategoriaId" @onchange="OnFiltroCategoriaChanged">
                    <option value="">Todas</option>
                    @foreach (var categoria in categoriasDisponibles)
                    {
                        <option value="@categoria.Id">@categoria.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Persona</label>
                <select class="form-select form-select-sm" value="@filtroPersonaId" @onchange="OnFiltroPersonaChanged">
                    <option value="">Todas</option>
                    @foreach (var persona in personasDisponibles)
                    {
                        <option value="@persona.Id">@persona.Nombre</option>
                    }
                </select>
            </div>
        </div>
        <div class="row g-2 mt-2">
            <div class="col-md-2">
                <label class="form-label small">Meta</label>
                <select class="form-select form-select-sm" value="@filtroMetaId" @onchange="OnFiltroMetaChanged">
                    <option value="">Todas</option>
                    @foreach (var meta in metasActivas)
                    {
                        <option value="@meta.Id">@meta.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Fecha desde</label>
                <input type="date" class="form-control form-control-sm"
                       value="@(filtroFechaDesde?.ToString("yyyy-MM-dd"))" @onchange="OnFiltroFechaDesdeChanged" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Fecha hasta</label>
                <input type="date" class="form-control form-control-sm"
                       value="@(filtroFechaHasta?.ToString("yyyy-MM-dd"))" @onchange="OnFiltroFechaHastaChanged" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Monto mínimo</label>
                <input type="number" step="0.01" class="form-control form-control-sm"
                       value="@filtroMontoMin" @onchange="OnFiltroMontoMinChanged" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Monto máximo</label>
                <input type="number" step="0.01" class="form-control form-control-sm"
                       value="@filtroMontoMax" @onchange="OnFiltroMontoMaxChanged" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <small class="text-muted">
                    Mostrando @movimientosFiltrados.Count de @(movimientos?.Count ?? 0) movimientos
                </small>
            </div>
        </div>
    </div>
</div>
<!-- =================== FIN FILTROS =================== -->

@if (movimientos == null)
{
    <p>Cargando...</p>
}
else
{
    <!-- Tabla desktop -->
    <div class="d-none d-md-block">
        <table class="table table-dark table-striped">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Cuenta</th>
                    <th>Tipo</th>
                    <th>Categoría</th>
                    <th>Persona</th>
                    <th>Descripción</th>
                    <th>Referencia</th>
                    <th>Monto</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!movimientosFiltrados.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            No hay movimientos que coincidan con los filtros aplicados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var mov in movimientosFiltrados)
                    {
                        <tr>
                            <td>@mov.FechaOcurrido.ToString("dd/MM/yyyy")</td
                            <td>@mov.NombreCuenta</td
                            <td>@mov.Tipo</td
                            <td>@mov.Categoria</td
                            <td>@mov.NombrePersona</td
                            <td style="max-width:150px;">@mov.Descripcion</td
                            <td style="max-width:125px; overflow:hidden; text-overflow:ellipsis;" title="@mov.ReferenciaAuto">@mov.ReferenciaAuto</td
                            <td>@mov.Monto.ToString("C")</td
                            <td style="min-width: 110px;">
                                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                                    <button class="btn btn-sm btn-warning" @onclick="() => AbrirModal(mov)">Editar</button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => EliminarMovimiento(mov)">Eliminar</button>
                                </div>
                            </td
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Tarjetas móvil -->
    <div class="d-block d-md-none">
        @if (!movimientosFiltrados.Any())
        {
            <p class="text-center text-muted py-4">No hay movimientos que coincidan con los filtros aplicados.</p>
        }
        else
        {
            @foreach (var mov in movimientosFiltrados)
            {
                <div class="card bg-dark text-white mb-3" style="border-left: 5px solid @mov.ColorCuenta;">
                    <div class="card-body">
                        <h5 class="card-title">@mov.Descripcion</h5>
                        <p class="card-text">
                            <strong>@mov.Monto.ToString("C")</strong><br />
                            @mov.FechaOcurrido.ToString("dd/MM/yyyy") - @mov.NombreCuenta<br />
                            @mov.Tipo / @mov.Categoria
                        </p>
                        <p class="card-text"><small>Ref: @mov.ReferenciaAuto</small></p>
                        <button class="btn btn-sm btn-warning" @onclick="() => AbrirModal(mov)">Editar</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => EliminarMovimiento(mov)">Eliminar</button>
                    </div>
                </div>
            }
        }
    </div>
}

<!-- Modal de movimiento -->
@if (modalVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal show d-block" tabindex="-1" role="dialog">
        
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" style="margin-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));">

            <div class="modal-content bg-dark text-white">
                <div class="modal-header">
                    <h5 class="modal-title">@(movimientoEditando == null ? "Nuevo movimiento" : "Editar movimiento")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Fecha</label>
                        <InputDate @bind-Value="formulario.Fecha" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" @bind="formulario.Tipo">
                            <option value="Ingreso">Ingreso</option>
                            <option value="Egreso">Egreso</option>
                            <option value="Transferencia">Transferencia</option>
                        </select>
                    </div>
                    @if (formulario.Tipo != "Transferencia")
                    {
                        <div class="mb-3">
                            <label class="form-label">Cuenta</label>
                            <div class="input-group">
                                <select class="form-select" @bind="formulario.CuentaId">
                                    @foreach (var cuenta in cuentasDisponibles)
                                    {
                                        <option value="@cuenta.Id">@cuenta.Nombre</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-success" @onclick="AgregarCuenta">+</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">Cuenta origen</label>
                            <div class="input-group">
                                <select class="form-select" @bind="formulario.CuentaOrigenId">
                                    @foreach (var cuenta in cuentasDisponibles)
                                    {
                                        <option value="@cuenta.Id">@cuenta.Nombre</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-success" @onclick="AgregarCuenta">+</button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Cuenta destino</label>
                            <div class="input-group">
                                <select class="form-select" @bind="formulario.CuentaDestinoId">
                                    @foreach (var cuenta in cuentasDisponibles)
                                    {
                                        <option value="@cuenta.Id">@cuenta.Nombre</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-success" @onclick="AgregarCuenta">+</button>
                            </div>
                        </div>
                    }
                    @if (formulario.Tipo != "Transferencia")
                    {
                        <div class="mb-3">
                            <label class="form-label">Categoría</label>
                            <div class="input-group">
                                <select class="form-select" @bind="formulario.CategoriaId">
                                    @foreach (var categoria in categoriasFiltradas)
                                    {
                                        <option value="@categoria.Id">@categoria.Nombre</option>
                                    }
                                </select>
                                <button type="button" class="btn btn-outline-success" @onclick="AgregarCategoria">+</button>
                            </div>
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">Persona (opcional)</label>
                        <div class="input-group">
                            <select class="form-select" @bind="formulario.PersonaId">
                                <option value="">(Ninguna)</option>
                                @foreach (var persona in personasDisponibles)
                                {
                                    <option value="@persona.Id">@persona.Nombre</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-success" @onclick="AgregarPersona">+</button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Descripción</label>
                        <input type="text" class="form-control" @bind="formulario.Descripcion" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Monto</label>
                        <input type="number" step="0.01" class="form-control" @bind="formulario.Monto" />
                    </div>
                    @if (mostrarCamposPrestamo)
                    {
                        <div class="mb-3">
                            <label class="form-label">Monto final (con intereses)</label>
                            <input type="number" step="0.01" class="form-control" @bind="formulario.MontoFinal" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Plazos (meses)</label>
                            <input type="number" class="form-control" @bind="formulario.Plazos" />
                        </div>
                    }
                    @if (formulario.Tipo == "Ingreso" && cuentaSeleccionada?.Visibilidad == "Ahorro")
                    {
                        <div class="mb-3">
                            <label class="form-label">Meta de ahorro (opcional)</label>
                            <select class="form-select" @bind="formulario.MetaId">
                                <option value="">(Ninguna)</option>
                                @foreach (var meta in metasActivas)
                                {
                                    <option value="@meta.Id">@meta.Nombre</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2 mt-3 pb-3">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button type="button" class="btn btn-primary" @onclick="GuardarMovimiento">Guardar</button>
                    </div>

                </div>
                <!-- modal-footer eliminado -->
            </div>
        </div>
    </div>
}

<!-- Modales para agregar entidades (fuera del modal anterior) -->
@if (mostrarModalCuenta)
{
    <ModalAgregarCuenta OnCuentaAgregada="OnCuentaAgregada" OnCancelar="() => mostrarModalCuenta = false" />
}
@if (mostrarModalCategoria)
{
    <ModalAgregarCategoria OnCategoriaAgregada="OnCategoriaAgregada" OnCancelar="() => mostrarModalCategoria = false" />
}
@if (mostrarModalPersona)
{
    <ModalAgregarPersona OnPersonaAgregada="OnPersonaAgregada" OnCancelar="() => mostrarModalPersona = false" />
}

@code {
    private DatosApp datos = null!;
    private List<MovimientoViewModel> movimientos = null!;
    private bool modalVisible = false;
    private MovimientoViewModel? movimientoEditando = null;
    private FormularioMovimiento formulario = new();
    private List<Cuenta> cuentasDisponibles = new();
    private List<Categoria> categoriasDisponibles = new();
    private List<Persona> personasDisponibles = new();
    private List<Meta> metasActivas = new();
    private Dictionary<string, string> mapaNombresCuentas = new();
    private Dictionary<string, string> mapaColoresCuentas = new();
    private Dictionary<string, string> mapaNombresPersonas = new();
    private Dictionary<string, string> mapaNombresMetas = new();

    private bool mostrarModalCuenta = false;
    private bool mostrarModalCategoria = false;
    private bool mostrarModalPersona = false;

    // ========== ESTADO DE FILTROS ==========
    private string filtroTexto = "";
    private string filtroTipo = "";
    private string filtroCuentaId = "";
    private string filtroCategoriaId = "";
    private string filtroPersonaId = "";
    private string filtroMetaId = "";
    private DateTime? filtroFechaDesde = null;
    private DateTime? filtroFechaHasta = null;
    private decimal? filtroMontoMin = null;
    private decimal? filtroMontoMax = null;

    // Para el toggle en móvil
    private bool mostrarFiltros = false;

    private List<Categoria> categoriasFiltradas => formulario.Tipo switch
    {
        "Ingreso" => categoriasDisponibles.Where(c => c.TipoPermitido == "Ingreso" || c.TipoPermitido == "Ambos").ToList(),
        "Egreso" => categoriasDisponibles.Where(c => c.TipoPermitido == "Egreso" || c.TipoPermitido == "Ambos").ToList(),
        _ => categoriasDisponibles
    };

    private bool mostrarCamposPrestamo
    {
        get
        {
            var categoria = categoriasDisponibles.FirstOrDefault(c => c.Id == formulario.CategoriaId);
            return (formulario.Tipo == "Ingreso" && categoria?.Nombre == "Préstamo") ||
                   (formulario.Tipo == "Egreso" && categoria?.Nombre == "Cargo");
        }
    }

    // ========== LISTA FILTRADA (computed) ==========
    private List<MovimientoViewModel> movimientosFiltrados
    {
        get
        {
            if (movimientos == null) return new List<MovimientoViewModel>();

            IEnumerable<MovimientoViewModel> query = movimientos;

            if (!string.IsNullOrWhiteSpace(filtroTexto))
            {
                var texto = filtroTexto.Trim();
                query = query.Where(m =>
                    (m.Descripcion?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.ReferenciaAuto?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (m.NombreMeta?.Contains(texto, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (!string.IsNullOrEmpty(filtroTipo))
                query = query.Where(m => m.Tipo == filtroTipo);

            if (!string.IsNullOrEmpty(filtroCuentaId))
                query = query.Where(m => m.CuentaId == filtroCuentaId);

            if (!string.IsNullOrEmpty(filtroCategoriaId))
                query = query.Where(m => m.CategoriaId == filtroCategoriaId);

            if (!string.IsNullOrEmpty(filtroPersonaId))
                query = query.Where(m => m.PersonaId == filtroPersonaId);

            if (!string.IsNullOrEmpty(filtroMetaId))
                query = query.Where(m => m.MetaId == filtroMetaId);

            if (filtroFechaDesde.HasValue)
                query = query.Where(m => m.FechaOcurrido.Date >= filtroFechaDesde.Value.Date);

            if (filtroFechaHasta.HasValue)
                query = query.Where(m => m.FechaOcurrido.Date <= filtroFechaHasta.Value.Date);

            if (filtroMontoMin.HasValue)
                query = query.Where(m => m.Monto >= filtroMontoMin.Value);

            if (filtroMontoMax.HasValue)
                query = query.Where(m => m.Monto <= filtroMontoMax.Value);

            return query
                .OrderByDescending(m => m.FechaOcurrido)
                .ThenByDescending(m => m.FechaRegistro)
                .ToList();
        }
    }

    // ========== HANDLERS DE FILTROS ==========
    private void OnFiltroTextoChanged(ChangeEventArgs e)
    {
        filtroTexto = e.Value?.ToString() ?? "";
    }

    private void OnFiltroTipoChanged(ChangeEventArgs e)
    {
        filtroTipo = e.Value?.ToString() ?? "";
    }

    private void OnFiltroCuentaChanged(ChangeEventArgs e)
    {
        filtroCuentaId = e.Value?.ToString() ?? "";
    }

    private void OnFiltroCategoriaChanged(ChangeEventArgs e)
    {
        filtroCategoriaId = e.Value?.ToString() ?? "";
    }

    private void OnFiltroPersonaChanged(ChangeEventArgs e)
    {
        filtroPersonaId = e.Value?.ToString() ?? "";
    }

    private void OnFiltroFechaDesdeChanged(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString();
        filtroFechaDesde = string.IsNullOrEmpty(valor) ? null : DateTime.Parse(valor);
    }

    private void OnFiltroFechaHastaChanged(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString();
        filtroFechaHasta = string.IsNullOrEmpty(valor) ? null : DateTime.Parse(valor);
    }

    private void OnFiltroMontoMinChanged(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString();
        filtroMontoMin = (string.IsNullOrEmpty(valor) || !decimal.TryParse(valor, out var m)) ? null : m;
    }

    private void OnFiltroMontoMaxChanged(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString();
        filtroMontoMax = (string.IsNullOrEmpty(valor) || !decimal.TryParse(valor, out var m)) ? null : m;
    }

    private void OnFiltroMetaChanged(ChangeEventArgs e)
    {
        filtroMetaId = e.Value?.ToString() ?? "";
    }

    private bool HayFiltrosActivos()
    {
        return !string.IsNullOrEmpty(filtroTexto) ||
               !string.IsNullOrEmpty(filtroTipo) ||
               !string.IsNullOrEmpty(filtroCuentaId) ||
               !string.IsNullOrEmpty(filtroCategoriaId) ||
               !string.IsNullOrEmpty(filtroPersonaId) ||
               !string.IsNullOrEmpty(filtroMetaId) ||
               filtroFechaDesde.HasValue ||
               filtroFechaHasta.HasValue ||
               filtroMontoMin.HasValue ||
               filtroMontoMax.HasValue;
    }

    private void ToggleFiltros()
    {
        mostrarFiltros = !mostrarFiltros;
    }

    private void LimpiarFiltros()
    {
        filtroTexto = "";
        filtroTipo = "";
        filtroCuentaId = "";
        filtroCategoriaId = "";
        filtroPersonaId = "";
        filtroMetaId = "";
        filtroFechaDesde = null;
        filtroFechaHasta = null;
        filtroMontoMin = null;
        filtroMontoMax = null;
        mostrarFiltros = false; // Tras limpiar, ocultamos el panel en móvil
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        datos = await ArchivoService.CargarAsync();
        PrecalcularMapas(datos);
        CargarMovimientos();
        CargarListas();
        CargarMetasActivas();
    }

    private void PrecalcularMapas(DatosApp datos)
    {
        mapaNombresCuentas = datos.Cuentas.ToDictionary(c => c.Id, c => c.Nombre);
        mapaColoresCuentas = datos.Cuentas.ToDictionary(c => c.Id, c => c.Color);
        mapaNombresPersonas = datos.Personas.ToDictionary(p => p.Id, p => p.Nombre);
        mapaNombresMetas = datos.Metas.ToDictionary(m => m.Id, m => m.Nombre);
    }

    private void CargarListas()
    {
        cuentasDisponibles = datos.Cuentas.ToList();
        categoriasDisponibles = datos.Categorias.ToList();
        personasDisponibles = datos.Personas.ToList();
    }

    private void CargarMetasActivas()
    {
        metasActivas = datos.Metas
            .Where(m => !m.Completada && !m.Archivada)
            .OrderBy(m => m.Prioridad)
            .ThenBy(m => m.FechaCreacion)
            .ToList();
    }

    private void CargarMovimientos()
    {
        movimientos = datos.Movimientos.Select(m => new MovimientoViewModel
        {
            Id = m.Id,
            FechaOcurrido = m.FechaOcurrido,
            FechaRegistro = m.FechaRegistro,
            Tipo = m.Tipo,
            Categoria = m.Categoria,
            Descripcion = m.Descripcion ?? "",
            Monto = m.Monto,
            CuentaId = m.CuentaId,
            CategoriaId = m.CategoriaId ?? "",
            PersonaId = m.PersonaId ?? "",
            NombreCuenta = mapaNombresCuentas.GetValueOrDefault(m.CuentaId) ?? "Desconocida",
            ColorCuenta = mapaColoresCuentas.GetValueOrDefault(m.CuentaId) ?? "#FFFFFF",
            NombrePersona = m.PersonaId != null ? mapaNombresPersonas.GetValueOrDefault(m.PersonaId) ?? "" : "",
            ReferenciaAuto = m.ReferenciaAuto ?? "",
            MetaId = m.MetaId,
            NombreMeta = m.MetaId != null ? mapaNombresMetas.GetValueOrDefault(m.MetaId) ?? "" : ""
        }).ToList();
        StateHasChanged();
    }

    private void CerrarModal()
    {
        modalVisible = false;
        movimientoEditando = null;
        formulario = new FormularioMovimiento();
    }

    private void AbrirModal(MovimientoViewModel? mov = null)
    {
        movimientoEditando = mov;
        if (mov == null)
        {
            formulario = new FormularioMovimiento();
        }
        else
        {
            formulario = new FormularioMovimiento
            {
                Fecha = mov.FechaOcurrido,
                Tipo = mov.Tipo,
                CuentaId = mov.CuentaId,
                CategoriaId = mov.CategoriaId,
                PersonaId = mov.PersonaId,
                Descripcion = mov.Descripcion,
                Monto = mov.Monto
            };
            var original = datos.Movimientos.FirstOrDefault(m => m.Id == mov.Id);
            if (original != null)
            {
                formulario.MontoFinal = original.MontoFinal;
                formulario.Plazos = original.Plazos;
                formulario.MetaId = original.MetaId;
            }
        }
        modalVisible = true;
    }

