@page "/"
@page "/resumen"
@using YESSMobilePWA.Models
@using YESSMobilePWA.Services
@using System.Globalization
@inject IArchivoService ArchivoService
@inject IDeudaCalculatorService DeudaCalculatorService

<style>
    @@media (max-width: 768px) {
        .categoria-card {
            margin-bottom: 1rem;
        }
    }
    
    .tabla-historial tbody tr:nth-child(even) {
        background-color: rgba(255, 255, 255, 0.03);
    }
    
    .tabla-historial tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.08);
    }
    .meta-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    }
</style>

<h3 class="text-center mb-4">Resumen Financiero</h3>

@if (cargando)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <!-- ========== PANEL 1: FLUJOS DEL MES ACTUAL ========== -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-success shadow">
                <div class="card-body">
                    <h5 class="card-title">Ingresos</h5>
                    <p class="card-text display-6">@totalIngresosEsteMes.ToString("C")</p>
                    <small class="text-light">Este mes</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-danger shadow">
                <div class="card-body">
                    <h5 class="card-title">Egresos</h5>
                    <p class="card-text display-6">@totalEgresosEsteMes.ToString("C")</p>
                    <small class="text-light">Este mes</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info shadow">
                <div class="card-body">
                    <h5 class="card-title">Diferencia</h5>
                    <p class="card-text display-6">@ahorroNetoEsteMes.ToString("C")</p>
                    <small class="text-light">Ingresos - Egresos</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white shadow" style="@GetEstiloIndicador()">
                <div class="card-body">
                    <h5 class="card-title">Salud</h5>
                    <p class="card-text display-6">@GetEtiquetaSalud()</p>
                    <small class="text-light">@($"{ratioGastoIngreso:F0}% del ingreso")</small>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== PANEL 3: COMPARATIVA MES ACTUAL VS MES ANTERIOR ========== -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card text-white shadow border-0" style="background: linear-gradient(135deg, #2c3e50 0%, #4a6572 100%);">
                <div class="card-header border-0" style="background-color: rgba(0,0,0,0.15);">
                    📈 Comparativa: Egresos
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>Este mes:</strong> @totalEgresosEsteMes.ToString("C")</p>
                    <p class="mb-3"><strong>Mes anterior:</strong> @totalEgresosMetePasado.ToString("C")</p>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span style="font-size: 1.5rem;">@GetTendenciaGasto()</span>
                        @if (diferenciaMesesGasto > 0)
                        {
                            <span style="
                                background-color: rgba(248, 113, 113, 0.15);
                                color: #f87171;
                                padding: 0.25rem 0.6rem;
                                border-radius: 999px;
                                font-weight: 600;
                                border: 1px solid rgba(248, 113, 113, 0.4);
                            ">
                                ↑ Gastas @($"{Math.Abs(diferenciaMesesGasto):C}") más
                            </span>
                        }
                        else if (diferenciaMesesGasto < 0)
                        {
                            <span style="
                                background-color: rgba(74, 222, 128, 0.15);
                                color: #4ade80;
                                padding: 0.25rem 0.6rem;
                                border-radius: 999px;
                                font-weight: 600;
                                border: 1px solid rgba(74, 222, 128, 0.4);
                            ">
                                ↓ Gastas @($"{Math.Abs(diferenciaMesesGasto):C}") menos
                            </span>
                        }
                        else
                        {
                            <span style="
                                background-color: rgba(250, 204, 21, 0.15);
                                color: #facc15;
                                padding: 0.25rem 0.6rem;
                                border-radius: 999px;
                                font-weight: 600;
                                border: 1px solid rgba(250, 204, 21, 0.4);
                            ">
                                → Igual que el mes anterior
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card text-white shadow border-0" style="background: linear-gradient(135deg, #1f3a5f 0%, #2e5c8a 100%);">
                <div class="card-header border-0" style="background-color: rgba(0,0,0,0.15);">
                    🔮 Proyección de gasto
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>Gasto diario promedio:</strong> @gastoDiarioPromedio.ToString("C")</p>
                    <p class="mb-3"><strong>Proyección si continúas así:</strong> @proyeccionGastoMes.ToString("C")</p>
                    
                    <small class="text-light">
                        @if (proyeccionGastoMes > totalIngresosEsteMes)
                        {
                            <span style="
                                background-color: rgba(248, 113, 113, 0.15);
                                color: #f87171;
                                padding: 0.25rem 0.6rem;
                                border-radius: 999px;
                                font-weight: 600;
                                border: 1px solid rgba(248, 113, 113, 0.4);
                                display: inline-block;
                            ">
                                ⚠️ Proyectarías gastar más de lo que ganas
                            </span>
                        }
                        else
                        {
                            <span style="
                                background-color: rgba(74, 222, 128, 0.15);
                                color: #4ade80;
                                padding: 0.25rem 0.6rem;
                                border-radius: 999px;
                                font-weight: 600;
                                border: 1px solid rgba(74, 222, 128, 0.4);
                                display: inline-block;
                            ">
                                ✅ Proyección dentro de ingresos
                            </span>
                        }
                    </small>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== PANEL 2: DÓNDE GASTAS MÁS (MEJORADO) ========== -->
    @if (topCategoriasGasto.Any())
    {
        <div class="card bg-dark text-white mb-4">
            <div class="card-header">📊 Dónde gastas más (este mes)</div>
            <div class="card-body">
                <div class="row">
                    @foreach (var cat in topCategoriasGasto)
                    {
                        var porcentajeGasto = totalEgresosEsteMes > 0 ? (cat.Total / totalEgresosEsteMes) * 100 : 0;
                        <div class="col-12 mb-3 categoria-card">
                            <div style="padding: 1rem; background-color: rgba(255,255,255,0.05); border-radius: 0.5rem; border-left: 4px solid @GetColorCategoria(cat.Categoria);">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="mb-0">
                                        <span style="font-size: 1.2rem;">@GetIconoCategoria(cat.Categoria)</span>
                                        <strong>@cat.Categoria</strong>
                                    </h6>
                                    <div class="text-end">
                                        <strong>@cat.Total.ToString("C")</strong><br />
                                        <small class="text-light">@porcentajeGasto.ToString("F1")% del gasto</small>
                                    </div>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar" role="progressbar" style="width: @porcentajeGasto%; background-color: @GetColorCategoria(cat.Categoria);" 
                                         aria-valuenow="@((int)porcentajeGasto)" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ========== HISTORIAL DE MOVIMIENTOS (TABLA MEJORADA) ========== -->
    <div class="card bg-dark text-white mb-4">
        <div class="card-header">📜 Historial de movimientos</div>
        <div class="card-body p-0">
            @if (ultimosMovimientos.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-striped mb-0 tabla-historial">
                        <thead>
                            <tr style="background-color: rgba(0,0,0,0.3);">
                                <th>📅 Fecha</th>
                                <th>🏦 Cuenta</th>
                                <th>🏷️ Categoría</th>
                                <th>📝 Descripción</th>
                                <th class="text-end">💰 Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mov in ultimosMovimientos)
                            {
                                <tr style="border-left: 3px solid @GetColorPorTipo(mov.Tipo);">
                                    <td>@mov.FechaOcurrido.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span style="padding: 0.25rem 0.5rem; background-color: rgba(255,255,255,0.1); border-radius: 0.25rem;">
                                            @mov.NombreCuenta
                                        </span>
                                    </td>
                                    <td>
                                        <span style="padding: 0.25rem 0.5rem; background-color: @GetColorCategoria(mov.Categoria); border-radius: 0.25rem; color: white; font-size: 0.85rem;">
                                            @mov.Categoria
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(mov.Descripcion))
                                        {
                                            <span class="text-light">@mov.Descripcion</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-end @(mov.Tipo == "Ingreso" ? "text-success" : "text-danger")">
                                        <strong>@(mov.Tipo == "Ingreso" ? "+" : "-")@mov.Monto.ToString("C")</strong>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-center p-3">No hay movimientos registrados</p>
            }
        </div>
    </div>

    <!-- ========== METAS ACTIVAS (MEJORADO) ========== -->
    <div class="card bg-dark text-white">
        <div class="card-header">🎯 Metas de ahorro activas (top 3)</div>
        <div class="card-body">
            @if (topMetas.Any())
            {
                <div class="row g-3">
                    @foreach (var meta in topMetas)
                    {
                        var pct = PorcentajeMeta(meta);
                        var faltante = Math.Max(0, meta.MontoObjetivo - meta.AhorradoActual);
                        <div class="col-md-4">
                            <div class="meta-card h-100" style="
                                background: linear-gradient(160deg, rgba(255,255,255,0.06) 0%, rgba(255,255,255,0.02) 100%);
                                border-radius: 0.75rem;
                                padding: 1.25rem;
                                position: relative;
                                overflow: hidden;
                                border-top: 4px solid transparent;
                                border-image: linear-gradient(90deg, @GetColorProgreso(pct) 0%, @GetColorProgresoSecundario(pct) 100%);
                                border-image-slice: 1;
                                transition: transform 0.2s ease, box-shadow 0.2s ease;
                            ">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div style="font-size: 2rem; line-height: 1;">
                                        @GetIconoMeta(meta.Nombre)
                                    </div>
                                    <div class="text-end">
                                        <div style="font-size: 1.75rem; font-weight: 700; color: @GetColorProgreso(pct); line-height: 1;">
                                            @pct.ToString("F0")%
                                        </div>
                                    </div>
                                </div>

                                <h5 class="mb-2" style="font-weight: 600;">@meta.Nombre</h5>

                                <div class="d-flex justify-content-between mb-1" style="font-size: 0.85rem;">
                                    <span class="text-light">Ahorrado</span>
                                    <strong style="color: @GetColorProgreso(pct);">@meta.AhorradoActual.ToString("C")</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-3" style="font-size: 0.85rem;">
                                    <span class="text-light">Objetivo</span>
                                    <span>@meta.MontoObjetivo.ToString("C")</span>
                                </div>

                                <div class="progress mb-3" style="height: 10px; background-color: rgba(255,255,255,0.08); border-radius: 999px;">
                                    <div class="progress-bar" role="progressbar"
                                         style="width: @pct%; background: linear-gradient(90deg, @GetColorProgreso(pct) 0%, @GetColorProgresoSecundario(pct) 100%); border-radius: 999px; transition: width 0.6s ease;"
                                         aria-valuenow="@((int)pct)" aria-valuemin="0" aria-valuemax="100">
                                    </div>
                                </div>

                                <div class="text-center" style="font-size: 0.85rem;">
                                    @if (pct >= 100)
                                    {
                                        <span style="
                                            background-color: rgba(74, 222, 128, 0.15);
                                            color: #4ade80;
                                            padding: 0.25rem 0.6rem;
                                            border-radius: 999px;
                                            font-weight: 600;
                                            border: 1px solid rgba(74, 222, 128, 0.4);
                                            display: inline-block;
                                        ">
                                            🎉 ¡Meta completada!
                                        </span>
                                    }
                                    else if (pct >= 75)
                                    {
                                        <span style="
                                            background-color: rgba(74, 222, 128, 0.15);
                                            color: #4ade80;
                                            padding: 0.25rem 0.6rem;
                                            border-radius: 999px;
                                            font-weight: 600;
                                            border: 1px solid rgba(74, 222, 128, 0.4);
                                            display: inline-block;
                                        ">
                                            🔥 ¡Casi lo logras! Faltan @faltante.ToString("C")
                                        </span>
                                    }
                                    else if (pct >= 50)
                                    {
                                        <span style="
                                            background-color: rgba(250, 204, 21, 0.15);
                                            color: #facc15;
                                            padding: 0.25rem 0.6rem;
                                            border-radius: 999px;
                                            font-weight: 600;
                                            border: 1px solid rgba(250, 204, 21, 0.4);
                                            display: inline-block;
                                        ">
                                            💪 Vas por buen camino
                                        </span>
                                    }
                                    else if (pct > 0)
                                    {
                                        <span style="
                                            background-color: rgba(96, 165, 250, 0.15);
                                            color: #60a5fa;
                                            padding: 0.25rem 0.6rem;
                                            border-radius: 999px;
                                            font-weight: 600;
                                            border: 1px solid rgba(96, 165, 250, 0.4);
                                            display: inline-block;
                                        ">
                                            🚀 ¡A darle!
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="
                                            background-color: rgba(148, 163, 184, 0.15);
                                            color: #94a3b8;
                                            padding: 0.25rem 0.6rem;
                                            border-radius: 999px;
                                            font-weight: 600;
                                            border: 1px solid rgba(148, 163, 184, 0.4);
                                            display: inline-block;
                                        ">
                                            ✨ Empieza hoy
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-center">No hay metas activas</p>
            }
        </div>
    </div>
}

@code {
    private DatosApp? datos;
    private bool cargando = true;

    private decimal totalIngresosEsteMes;
    private decimal totalEgresosEsteMes;
    private decimal ahorroNetoEsteMes;
    private decimal ratioGastoIngreso;

    private decimal totalEgresosMetePasado;
    private decimal diferenciaMesesGasto;
    private decimal gastoDiarioPromedio;
    private decimal proyeccionGastoMes;

    private List<MovimientoViewModel> ultimosMovimientos = new();
    private List<CategoriaGastoViewModel> topCategoriasGasto = new();
    private List<Meta> topMetas = new();

    private class MovimientoViewModel
    {
        public DateTime FechaOcurrido { get; set; }
        public DateTime FechaRegistro { get; set; }
        public string NombreCuenta { get; set; } = "";
        public string Categoria { get; set; } = "";
        public string Descripcion { get; set; } = "";
        public decimal Monto { get; set; }
        public string Tipo { get; set; } = "";
    }

    private class CategoriaGastoViewModel
    {
        public string Categoria { get; set; } = "";
        public decimal Total { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            cargando = true;
            datos = await ArchivoService.CargarAsync();
            if (datos?.Movimientos != null)
            {
                CalcularMetricas();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR EN RESUMEN: {ex.Message}");
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void CalcularMetricas()
    {
        if (datos?.Movimientos == null) return;

        // ========== RANGOS DE FECHAS CALENDARIO ==========
        var ahora = DateTime.Now;
        var primerDiaEsteMes = new DateTime(ahora.Year, ahora.Month, 1);
        var ultimoDiaEsteMes = primerDiaEsteMes.AddMonths(1).AddDays(-1);

        var primerDiaMetePasado = primerDiaEsteMes.AddMonths(-1);
        var ultimoDiaMetePasado = primerDiaEsteMes.AddDays(-1);

        // ========== MOVIMIENTOS REALES (excluye Transferencia y categorías deuda) ==========
        var movimientosReales = datos.Movimientos
            .Where(m => !string.IsNullOrEmpty(m.Categoria) 
                && m.Categoria != "Transferencia"
                && !DeudaCalculatorService.CategoriasDeuda.Contains(m.Categoria))
            .ToList();

        // ========== PANEL 1: FLUJOS DEL MES ACTUAL ==========
        var movimientosEsteMes = movimientosReales
            .Where(m => m.FechaOcurrido >= primerDiaEsteMes && m.FechaOcurrido <= ultimoDiaEsteMes)
            .ToList();

        totalIngresosEsteMes = movimientosEsteMes.Where(m => m.Tipo == "Ingreso").Sum(m => m.Monto);
        totalEgresosEsteMes = movimientosEsteMes.Where(m => m.Tipo == "Egreso").Sum(m => m.Monto);
        ahorroNetoEsteMes = totalIngresosEsteMes - totalEgresosEsteMes;

        // Ratio gasto/ingreso para indicador de salud
        ratioGastoIngreso = totalIngresosEsteMes > 0 
            ? (totalEgresosEsteMes / totalIngresosEsteMes) * 100 
            : 0;

        // ========== PANEL 2: GASTO POR CATEGORÍA (TOP 5) ==========
        topCategoriasGasto = movimientosEsteMes
            .Where(m => m.Tipo == "Egreso")
            .GroupBy(m => m.Categoria)
            .Select(g => new CategoriaGastoViewModel
            {
                Categoria = g.Key,
                Total = g.Sum(m => m.Monto)
            })
            .OrderByDescending(c => c.Total)
            .Take(5)
            .ToList();

        // ========== PANEL 3: COMPARATIVA CON MES ANTERIOR ==========
        var movimientosMetePasado = movimientosReales
            .Where(m => m.FechaOcurrido >= primerDiaMetePasado && m.FechaOcurrido <= ultimoDiaMetePasado)
            .ToList();

        totalEgresosMetePasado = movimientosMetePasado.Where(m => m.Tipo == "Egreso").Sum(m => m.Monto);
        diferenciaMesesGasto = totalEgresosEsteMes - totalEgresosMetePasado;

        // ========== PROYECCIÓN ==========
        var diasTranscurridos = (DateTime.Now - primerDiaEsteMes).Days + 1;
        var diasEnMes = ultimoDiaEsteMes.Day;
        gastoDiarioPromedio = diasTranscurridos > 0 ? totalEgresosEsteMes / diasTranscurridos : 0;
        proyeccionGastoMes = gastoDiarioPromedio * diasEnMes;

        // ========== ÚLTIMOS 7 MOVIMIENTOS (TABLA COMPLETA) ==========
        var ultimos = datos.Movimientos
            .Where(m => !string.IsNullOrEmpty(m.Categoria) && m.Categoria != "Transferencia")
            .OrderByDescending(m => m.FechaOcurrido)
            .ThenByDescending(m => m.FechaRegistro)
            .Take(7)
            .ToList();

        var mapaCuentas = datos.Cuentas.ToDictionary(c => c.Id, c => c.Nombre);
        ultimosMovimientos = ultimos.Select(m => new MovimientoViewModel
        {
            FechaOcurrido = m.FechaOcurrido,
            FechaRegistro = m.FechaRegistro,
            NombreCuenta = mapaCuentas.GetValueOrDefault(m.CuentaId) ?? "Desconocida",
            Categoria = m.Categoria,
            Descripcion = m.Descripcion ?? "",
            Monto = m.Monto,
            Tipo = m.Tipo
        }).ToList();

        // ========== METAS ACTIVAS (TOP 3) ==========
        var todasMetas = datos.Metas ?? new List<Meta>();
        var activas = todasMetas.Where(m => !m.Completada && !m.Archivada)
            .OrderBy(m => m.Prioridad)
            .ThenBy(m => m.FechaCreacion)
            .ToList();

        foreach (var meta in activas)
        {
            meta.AhorradoActual = datos.Movimientos
                .Where(m => m.MetaId == meta.Id && m.Tipo == "Ingreso")
                .Sum(m => m.Monto);
        }
        topMetas = activas.Take(3).ToList();
    }

    private double PorcentajeMeta(Meta meta)
    {
        if (meta.MontoObjetivo == 0) return 0;
        return (double)(meta.AhorradoActual / meta.MontoObjetivo) * 100;
    }

    private string GetEtiquetaSalud()
    {
        if (ratioGastoIngreso < 80) return "✅ Sano";
        if (ratioGastoIngreso < 100) return "⚠️ Justo";
        return "❌ Déficit";
    }

    private string GetEstiloIndicador()
    {
        if (ratioGastoIngreso < 80) return "background-color: #28a745;";
        if (ratioGastoIngreso < 100) return "background-color: #ffc107;";
        return "background-color: #dc3545;";
    }

    private string GetColorCategoria(string categoria)
    {
        var colores = new Dictionary<string, string>
        {
            { "Comida", "#dc3545" },
            { "Transporte", "#fd7e14" },
            { "Entretenimiento", "#9c27b0" },
            { "Salud", "#e91e63" },
            { "Educación", "#2196f3" },
            { "Servicios", "#ff9800" },
            { "Compras", "#f44336" },
            { "Otros", "#795548" },
            { "Abono", "#28a745" }
        };

        return colores.TryGetValue(categoria, out var color) ? color : "#666";
    }

    private string GetIconoCategoria(string categoria)
    {
        var iconos = new Dictionary<string, string>
        {
            { "Comida", "🍔" },
            { "Transporte", "🚗" },
            { "Entretenimiento", "🎮" },
            { "Salud", "🏥" },
            { "Educación", "📚" },
            { "Servicios", "⚡" },
            { "Compras", "🛍️" },
            { "Otros", "📦" },
            { "Abono", "💰" }
        };

        return iconos.TryGetValue(categoria, out var icono) ? icono : "📊";
    }

    private string GetColorPorTipo(string tipo)
    {
        return tipo == "Ingreso" ? "#28a745" : "#dc3545";
    }

    private string GetTendenciaGasto()
    {
        if (diferenciaMesesGasto > 0) return "📈";
        if (diferenciaMesesGasto < 0) return "📉";
        return "➡️";
    }

    private string GetColorTendencia()
    {
        if (diferenciaMesesGasto > 0) return "text-danger";
        if (diferenciaMesesGasto < 0) return "text-success";
        return "text-warning";
    }

        private string GetIconoMeta(string nombre)
    {
        var n = (nombre ?? "").ToLowerInvariant();
        if (n.Contains("viaje") || n.Contains("vacacion")) return "✈️";
        if (n.Contains("auto") || n.Contains("carro") || n.Contains("coche")) return "🚗";
        if (n.Contains("casa") || n.Contains("depa") || n.Contains("hogar")) return "🏠";
        if (n.Contains("emergencia")) return "🚨";
        if (n.Contains("estudio") || n.Contains("curso") || n.Contains("educa")) return "🎓";
        if (n.Contains("moto")) return "🏍️";
        if (n.Contains("bici")) return "🚲";
        if (n.Contains("celu") || n.Contains("telefono") || n.Contains("iphone")) return "📱";
        if (n.Contains("compu") || n.Contains("laptop") || n.Contains("pc")) return "💻";
        if (n.Contains("juego") || n.Contains("consola")) return "🎮";
        if (n.Contains("ropa")) return "👕";
        if (n.Contains("regalo")) return "🎁";
        if (n.Contains("boda")) return "💍";
        if (n.Contains("salud") || n.Contains("medic")) return "🏥";
        if (n.Contains("inversion") || n.Contains("invertir")) return "📈";
        return "🎯";
    }

    private string GetColorProgreso(double pct)
    {
        if (pct >= 100) return "#4ade80";
        if (pct >= 75) return "#4ade80";
        if (pct >= 50) return "#facc15";
        if (pct > 0) return "#60a5fa";
        return "#94a3b8";
    }

    private string GetColorProgresoSecundario(double pct)
    {
        if (pct >= 100) return "#22d3ee";
        if (pct >= 75) return "#22d3ee";
        if (pct >= 50) return "#fb923c";
        if (pct > 0) return "#818cf8";
        return "#64748b";
    }
}