@page "/metas"
@using YESSMobilePWA.Models
@using YESSMobilePWA.Services
@using System.Globalization
@inject ArchivoService ArchivoService
@inject IJSRuntime JS

<h3>Metas de ahorro</h3>

@if (cargando)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <!-- META PRINCIPAL -->
    @if (metaPrincipal != null)
    {
        <div class="card bg-dark text-white mb-4">
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-3 d-flex justify-content-center mb-3 mb-md-0">
                        <svg width="140" height="140" viewBox="0 0 120 120">
                            <circle cx="60" cy="60" r="50" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="10" />
                            <circle cx="60" cy="60" r="50" fill="none"
                                    stroke="@ColorBordePanel(metaPrincipal)"
                                    stroke-width="10"
                                    stroke-linecap="round"
                                    stroke-dasharray="@CircunferenciaAnillo"
                                    stroke-dashoffset="@DashOffsetAnillo(metaPrincipal)"
                                    transform="rotate(-90 60 60)"
                                    style="transition: stroke-dashoffset 0.4s ease;" />
                            <text x="60" y="56" text-anchor="middle" dominant-baseline="middle" font-size="26" font-weight="bold" fill="white">@Porcentaje(metaPrincipal).ToString("F0")%</text>
                            <text x="60" y="82" text-anchor="middle" dominant-baseline="middle" font-size="18" fill="#adb5bd">@metaPrincipal.Icono</text>
                        </svg>
                    </div>
                    <div class="col-md-5">
                        <h4 class="mb-2">@metaPrincipal.Nombre</h4>
                        <p class="mb-1"><strong>Objetivo:</strong> @metaPrincipal.MontoObjetivo.ToString("C")</p>
                        <p class="mb-1"><strong>Ahorrado:</strong> @metaPrincipal.AhorradoActual.ToString("C")</p>
                        <p class="text-muted small mt-2 mb-0">@ProyeccionTexto(metaPrincipal)</p>
                    </div>
                    <div class="col-md-4 mt-3 mt-md-0 d-flex flex-column justify-content-between">
                        <div class="p-3 rounded text-center mb-3"
                             style="background-color: @ColorFondoPanel(metaPrincipal); border: 2px solid @ColorBordePanel(metaPrincipal);">
                            <span class="fw-bold" style="font-size:1.1rem;">@MensajeMotivacional(metaPrincipal)</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 justify-content-md-end">
                            <button class="btn btn-sm btn-success" @onclick="() => CompletarMeta(metaPrincipal)">Completar</button>
                            <button class="btn btn-sm btn-warning" @onclick="() => AbrirModalEditar(metaPrincipal)">Editar</button>
                            <button class="btn btn-sm btn-secondary" @onclick="() => ArchivarMeta(metaPrincipal)">Archivar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">No hay meta principal. Crea una nueva meta para que aparezca aquí.</div>
    }

    <div class="mb-3">
        <button class="btn btn-primary" @onclick="AbrirModalNueva">+ Nueva Meta</button>
    </div>

    <!-- OTRAS METAS ACTIVAS -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-3" style="cursor:pointer; user-select:none;" @onclick="() => mostrarOtrasActivas = !mostrarOtrasActivas">
        <h5 class="mb-0">
            <span class="oi @(mostrarOtrasActivas ? "oi-caret-bottom" : "oi-caret-right")" aria-hidden="true"></span>
            Otras Metas Activas
            <span class="badge bg-secondary ms-1">@otrasMetasActivas.Count</span>
        </h5>
    </div>
    @if (mostrarOtrasActivas)
    {
        @if (otrasMetasActivas.Any())
        {
            <div class="d-none d-md-block">
                <div class="table-responsive">
                    <table class="table table-dark table-striped">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Objetivo</th>
                                <th>Ahorrado</th>
                                <th>Progreso</th>
                                <th>Prioridad</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var meta in otrasMetasActivas)
                            {
                                <tr>
                                    <td>@meta.Icono @meta.Nombre</td>
                                    <td>@meta.MontoObjetivo.ToString("C")</td>
                                    <td>@meta.AhorradoActual.ToString("C")</td>
                                    <td>
                                        <div class="progress" style="width: 100px;">
                                            <div class="progress-bar @ClaseColorBarra(meta)" role="progressbar"
                                                 style="width: @Porcentaje(meta)%;">
                                                @Porcentaje(meta).ToString("F0")%
                                            </div>
                                        </div>
                                    </td>
                                    <td>@meta.Prioridad</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <button class="btn btn-sm btn-outline-light" title="Subir prioridad" @onclick="() => MoverMeta(meta, -1)">▲</button>
                                            <button class="btn btn-sm btn-outline-light" title="Bajar prioridad" disabled="@(meta == otrasMetasActivas.Last())" @onclick="() => MoverMeta(meta, 1)">▼</button>
                                            <button class="btn btn-sm btn-success" title="Completar" @onclick="() => CompletarMeta(meta)">✔</button>
                                            <button class="btn btn-sm btn-warning" title="Editar" @onclick="() => AbrirModalEditar(meta)">✏</button>
                                            <button class="btn btn-sm btn-secondary" title="Archivar" @onclick="() => ArchivarMeta(meta)">📦</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-block d-md-none">
                @foreach (var meta in otrasMetasActivas)
                {
                    <div class="card bg-dark text-white mb-3">
                        <div class="card-body">
                            <h6 class="card-title">@meta.Icono @meta.Nombre</h6>
                            <p class="mb-2">
                                <strong>Objetivo:</strong> @meta.MontoObjetivo.ToString("C")<br />
                                <strong>Ahorrado:</strong> @meta.AhorradoActual.ToString("C")<br />
                                <strong>Prioridad:</strong> @meta.Prioridad
                            </p>

                            <div class="p-2 rounded" style="background-color: @ColorFondoPanel(meta);">
                                <div class="progress mb-1" style="height: 18px;">
                                    <div class="progress-bar @ClaseColorBarra(meta)" role="progressbar"
                                         style="width: @Porcentaje(meta)%; font-size:0.7rem;">
                                        @Porcentaje(meta).ToString("F0")%
                                    </div>
                                </div>
                                <div class="fw-bold text-center" style="font-size:0.75rem;">@MensajeMotivacional(meta)</div>
                            </div>

                            <p class="text-muted small mt-2 mb-2">@ProyeccionTexto(meta)</p>
                            <div class="d-flex gap-2 flex-wrap">
                                <button class="btn btn-sm btn-outline-light" @onclick="() => MoverMeta(meta, -1)">▲ Subir</button>
                                <button class="btn btn-sm btn-outline-light" disabled="@(meta == otrasMetasActivas.Last())" @onclick="() => MoverMeta(meta, 1)">▼ Bajar</button>
                                <button class="btn btn-sm btn-success" @onclick="() => CompletarMeta(meta)">Completar</button>
                                <button class="btn btn-sm btn-warning" @onclick="() => AbrirModalEditar(meta)">Editar</button>
                                <button class="btn btn-sm btn-secondary" @onclick="() => ArchivarMeta(meta)">Archivar</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p>No hay otras metas activas.</p>
        }
    }

    <!-- METAS COMPLETADAS -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-3" style="cursor:pointer; user-select:none;" @onclick="() => mostrarCompletadas = !mostrarCompletadas">
        <h5 class="mb-0">
            <span class="oi @(mostrarCompletadas ? "oi-caret-bottom" : "oi-caret-right")" aria-hidden="true"></span>
            Metas completadas
            <span class="badge bg-secondary ms-1">@metasCompletadas.Count</span>
        </h5>
    </div>
    @if (mostrarCompletadas)
    {
        @if (metasCompletadas.Any())
        {
            <div class="d-none d-md-block">
                <div class="table-responsive">
                    <table class="table table-dark table-striped">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Objetivo</th>
                                <th>Lograda el</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var meta in metasCompletadas)
                            {
                                <tr>
                                    <td>@meta.Icono @meta.Nombre</td>
                                    <td>@meta.MontoObjetivo.ToString("C")</td>
                                    <td>@(meta.FechaCompletada?.ToString("dd/MM/yyyy") ?? "")</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <button class="btn btn-sm btn-outline-light" title="Reactivar" @onclick="() => ReactivarMeta(meta)">↩ Reactivar</button>
                                            <button class="btn btn-sm btn-secondary" @onclick="() => ArchivarMeta(meta)">Archivar</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-block d-md-none">
                @foreach (var meta in metasCompletadas)
                {
                    <div class="card bg-dark text-white mb-3">
                        <div class="card-body">
                            <h6 class="card-title">@meta.Icono @meta.Nombre</h6>
                            <p>
                                <strong>Objetivo:</strong> @meta.MontoObjetivo.ToString("C")<br />
                                <strong>Lograda el:</strong> @(meta.FechaCompletada?.ToString("dd/MM/yyyy") ?? "")
                            </p>
                            <div class="d-flex gap-2 flex-wrap">
                                <button class="btn btn-sm btn-outline-light" @onclick="() => ReactivarMeta(meta)">↩ Reactivar</button>
                                <button class="btn btn-sm btn-secondary" @onclick="() => ArchivarMeta(meta)">Archivar</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p>No hay metas completadas.</p>
        }
    }

    <!-- METAS ARCHIVADAS -->
    <div class="d-flex justify-content-between align-items-center mt-4 mb-3" style="cursor:pointer; user-select:none;" @onclick="() => mostrarArchivadas = !mostrarArchivadas">
        <h5 class="mb-0">
            <span class="oi @(mostrarArchivadas ? "oi-caret-bottom" : "oi-caret-right")" aria-hidden="true"></span>
            Metas archivadas
            <span class="badge bg-secondary ms-1">@metasArchivadas.Count</span>
        </h5>
    </div>
    @if (mostrarArchivadas)
    {
        @if (metasArchivadas.Any())
        {
            <div class="d-none d-md-block">
                <div class="table-responsive">
                    <table class="table table-dark table-striped">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Objetivo</th>
                                <th>Archivada el</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var meta in metasArchivadas)
                            {
                                <tr>
                                    <td>@meta.Icono @meta.Nombre</td>
                                    <td>@meta.MontoObjetivo.ToString("C")</td>
                                    <td>@(meta.FechaArchivada?.ToString("dd/MM/yyyy") ?? "")</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <button class="btn btn-sm btn-success" @onclick="() => RestaurarMeta(meta)">Restaurar</button>
                                            <button class="btn btn-sm btn-danger" @onclick="() => EliminarMeta(meta)">Eliminar</button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="d-block d-md-none">
                @foreach (var meta in metasArchivadas)
                {
                    <div class="card bg-dark text-white mb-3">
                        <div class="card-body">
                            <h6 class="card-title">@meta.Icono @meta.Nombre</h6>
                            <p>
                                <strong>Objetivo:</strong> @meta.MontoObjetivo.ToString("C")<br />
                                <strong>Archivada el:</strong> @(meta.FechaArchivada?.ToString("dd/MM/yyyy") ?? "")
                            </p>
                            <div class="d-flex gap-2 flex-wrap">
                                <button class="btn btn-sm btn-success" @onclick="() => RestaurarMeta(meta)">Restaurar</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => EliminarMeta(meta)">Eliminar</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p>No hay metas archivadas.</p>
        }
    }
}

<!-- MODAL PARA CREAR/EDITAR META -->
@if (modalVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content bg-dark text-white">
                <div class="modal-header">
                    <h5 class="modal-title">@(metaEditando == null ? "Nueva meta" : "Editar meta")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Ícono</label>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var opcion in iconosDisponibles)
                            {
                                <button type="button" class="btn @(formulario.Icono == opcion ? "btn-primary" : "btn-outline-secondary")"
                                        style="font-size:1.3rem; line-height:1;" @onclick="() => formulario.Icono = opcion">
                                    @opcion
                                </button>
                            }
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" @bind="formulario.Nombre" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Monto objetivo</label>
                        <input type="number" step="0.01" class="form-control" @bind="formulario.MontoObjetivo" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Prioridad (1 = más urgente)</label>
                        <input type="number" step="1" min="1" class="form-control" @bind="formulario.Prioridad" />
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-3 pb-3">
                        <button class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button class="btn btn-primary" @onclick="GuardarMeta">Guardar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Meta> todasMetas = new();
    private bool cargando = true;
    private Meta? metaPrincipal = null;
    private List<Meta> otrasMetasActivas = new();
    private List<Meta> metasCompletadas = new();
    private List<Meta> metasArchivadas = new();

    private bool modalVisible = false;
    private Meta? metaEditando = null;
    private MetaFormulario formulario = new();

    private bool mostrarOtrasActivas = true;
    private bool mostrarCompletadas = false;
    private bool mostrarArchivadas = false;

    private readonly string[] iconosDisponibles = { "🎯", "🏠", "✈️", "🚗", "💻", "🎓", "🎁", "💍", "🏥", "📱" };

    // Circunferencia del anillo SVG (radio 50): 2 * π * 50 ≈ 314.16
    private const double CircunferenciaAnillo = 314.159;

    private class MetaFormulario
    {
        public string Nombre { get; set; } = "";
        public decimal MontoObjetivo { get; set; }
        public int Prioridad { get; set; } = 1;
        public string Icono { get; set; } = "🎯";
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            cargando = true;
            var datos = await ArchivoService.CargarAsync();
            todasMetas = datos.Metas ?? new List<Meta>();
            CalcularAhorros(datos);
            ClasificarMetas();
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void CalcularAhorros(DatosApp datos)
    {
        var movimientos = datos.Movimientos ?? new List<Movimiento>();
        foreach (var meta in todasMetas)
        {
            meta.AhorradoActual = movimientos
                .Where(m => m.MetaId == meta.Id && m.Tipo == "Ingreso")
                .Sum(m => m.Monto);
        }
    }

    private void ClasificarMetas()
    {
        var activas = todasMetas.Where(m => !m.Completada && !m.Archivada).ToList();
        metasCompletadas = todasMetas.Where(m => m.Completada && !m.Archivada).OrderByDescending(m => m.FechaCompletada).ToList();
        metasArchivadas = todasMetas.Where(m => m.Archivada).OrderByDescending(m => m.FechaArchivada).ToList();

        activas = activas.OrderBy(m => m.Prioridad).ThenBy(m => m.FechaCreacion).ToList();
        metaPrincipal = activas.FirstOrDefault();
        otrasMetasActivas = activas.Skip(1).ToList();
    }

    private double Porcentaje(Meta meta)
    {
        if (meta.MontoObjetivo == 0) return 0;
        return (double)(meta.AhorradoActual / meta.MontoObjetivo) * 100;
    }

    private string ClaseColorBarra(Meta meta)
    {
        double pct = Porcentaje(meta);
        if (pct >= 90) return "bg-success";
        if (pct >= 50) return "bg-info";
        if (pct >= 25) return "bg-warning";
        return "bg-danger";
    }

    private string ColorFondoPanel(Meta meta)
    {
        double pct = Porcentaje(meta);
        if (pct >= 90) return "rgba(25,135,84,0.25)";
        if (pct >= 50) return "rgba(13,202,240,0.25)";
        if (pct >= 25) return "rgba(255,193,7,0.25)";
        return "rgba(220,53,69,0.25)";
    }

    private string ColorBordePanel(Meta meta)
    {
        double pct = Porcentaje(meta);
        if (pct >= 90) return "#198754";
        if (pct >= 50) return "#0dcaf0";
        if (pct >= 25) return "#ffc107";
        return "#dc3545";
    }

    // Desfase del trazo del anillo SVG — a mayor porcentaje, menor desfase
    // (el trazo "avanza" alrededor del círculo). Se limita a 100% para que
    // una meta sobre-ahorrada no intente dibujar más de una vuelta completa.
    private double DashOffsetAnillo(Meta meta)
    {
        double pct = Math.Min(100, Math.Max(0, Porcentaje(meta)));
        return CircunferenciaAnillo * (1 - pct / 100);
    }

    // Mensajes placeholder por fase — cámbialos por tu chiste real.
    private string MensajeMotivacional(Meta meta)
    {
        double pct = Porcentaje(meta);
        if (pct >= 90) return "🔥 Hazlo todo y luego haz más.";
        if (pct >= 50) return "💪 Vas mejor que muchos propósitos de año nuevo.";
        if (pct >= 25) return "🌱 Trabajo muy duro como un esclavo.";
        return "🐢 Apenas arrancando, pero algo es algo.";
    }

    private string ProyeccionTexto(Meta meta)
    {
        if (meta.AhorradoActual >= meta.MontoObjetivo)
            return "¡Meta alcanzada! Márcala como completada.";

        int mesesTranscurridos = Math.Max(1,
            (DateTime.Today.Year - meta.FechaCreacion.Year) * 12 + DateTime.Today.Month - meta.FechaCreacion.Month);

        if (meta.AhorradoActual <= 0)
            return "Aún sin ahorros registrados para proyectar una fecha.";

        decimal ritmoMensual = meta.AhorradoActual / mesesTranscurridos;
        if (ritmoMensual <= 0)
            return "Ritmo de ahorro insuficiente para proyectar una fecha.";

        decimal faltante = meta.MontoObjetivo - meta.AhorradoActual;
        int mesesFaltantes = (int)Math.Ceiling((double)(faltante / ritmoMensual));
        var fechaEstimada = DateTime.Today.AddMonths(mesesFaltantes);
        var cultura = CultureInfo.GetCultureInfo("es-MX");

        return $"A este ritmo (~{ritmoMensual.ToString("C")}/mes), la alcanzarás en ~{mesesFaltantes} {(mesesFaltantes == 1 ? "mes" : "meses")} ({CapitalizarMes(fechaEstimada.ToString("MMM yyyy", cultura))}).";
    }

    private string CapitalizarMes(string texto)
    {
        if (string.IsNullOrEmpty(texto)) return texto;
        return char.ToUpper(texto[0]) + texto.Substring(1);
    }

    private async Task MoverMeta(Meta meta, int direccion)
    {
        var activas = todasMetas.Where(m => !m.Completada && !m.Archivada)
            .OrderBy(m => m.Prioridad).ThenBy(m => m.FechaCreacion).ToList();

        int idx = activas.FindIndex(m => m.Id == meta.Id);
        int nuevoIdx = idx + direccion;
        if (idx == -1 || nuevoIdx < 0 || nuevoIdx >= activas.Count) return;

        (activas[idx], activas[nuevoIdx]) = (activas[nuevoIdx], activas[idx]);

        for (int i = 0; i < activas.Count; i++)
        {
            activas[i].Prioridad = i + 1;
        }

        await GuardarCambios();
        await CargarDatos();
    }

    private async Task CompletarMeta(Meta meta)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"¿Completar la meta '{meta.Nombre}'?"))
        {
            meta.Completada = true;
            meta.FechaCompletada = DateTime.Now;
            await GuardarCambios();
            await CargarDatos();
        }
    }

    private async Task ReactivarMeta(Meta meta)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"¿Reactivar la meta '{meta.Nombre}'? Volverá a la lista de metas activas."))
        {
            meta.Completada = false;
            meta.FechaCompletada = null;
            await GuardarCambios();
            await CargarDatos();
        }
    }

    private async Task ArchivarMeta(Meta meta)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"¿Archivar la meta '{meta.Nombre}'?"))
        {
            meta.Archivada = true;
            meta.FechaArchivada = DateTime.Now;
            await GuardarCambios();
            await CargarDatos();
        }
    }

    private async Task RestaurarMeta(Meta meta)
    {
        meta.Archivada = false;
        meta.FechaArchivada = null;
        meta.Completada = false;
        meta.FechaCompletada = null;
        await GuardarCambios();
        await CargarDatos();
    }

    private async Task EliminarMeta(Meta meta)
    {
        if (await JS.InvokeAsync<bool>("confirm", $"¿Eliminar permanentemente la meta '{meta.Nombre}'? Esta acción no se puede deshacer."))
        {
            todasMetas.Remove(meta);
            await GuardarCambios();
            await CargarDatos();
        }
    }

    private void AbrirModalNueva()
    {
        metaEditando = null;
        formulario = new MetaFormulario();
        modalVisible = true;
    }

    private void AbrirModalEditar(Meta meta)
    {
        metaEditando = meta;
        formulario = new MetaFormulario
        {
            Nombre = meta.Nombre,
            MontoObjetivo = meta.MontoObjetivo,
            Prioridad = meta.Prioridad,
            Icono = meta.Icono
        };
        modalVisible = true;
    }

    private async Task GuardarMeta()
    {
        if (string.IsNullOrWhiteSpace(formulario.Nombre))
        {
            await JS.InvokeVoidAsync("alert", "El nombre es obligatorio.");
            return;
        }
        if (formulario.MontoObjetivo <= 0)
        {
            await JS.InvokeVoidAsync("alert", "El monto objetivo debe ser mayor a cero.");
            return;
        }
        if (formulario.Prioridad < 1)
            formulario.Prioridad = 1;

        if (metaEditando == null)
        {
            var nueva = new Meta(formulario.Nombre, formulario.MontoObjetivo, formulario.Prioridad)
            {
                Icono = formulario.Icono
            };
            todasMetas.Add(nueva);
        }
        else
        {
            metaEditando.Nombre = formulario.Nombre;
            metaEditando.MontoObjetivo = formulario.MontoObjetivo;
            metaEditando.Prioridad = formulario.Prioridad;
            metaEditando.Icono = formulario.Icono;
        }

        await GuardarCambios();
        await CargarDatos();
        CerrarModal();
    }

    private async Task GuardarCambios()
    {
        var datos = await ArchivoService.CargarAsync();
        datos.Metas = todasMetas;
        await ArchivoService.GuardarAsync(datos);
    }

    private void CerrarModal()
    {
        modalVisible = false;
        metaEditando = null;
        formulario = new MetaFormulario();
    }
}