@page "/dashboard"
@using YESSMobilePWA.Models
@using YESSMobilePWA.Services
@using Radzen.Blazor
@using System.Globalization
@inject ArchivoService ArchivoService
@inject DeudaCalculatorService DeudaCalculatorService

<h3 class="text-center mb-4">Dashboard Financiero</h3>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <label class="form-label">Año:</label>
        <select class="form-select" value="@anioSeleccionado" @onchange="OnAnioChanged">
            <option value="todos">Todos</option>
            @foreach (var anio in aniosDisponibles)
            {
                <option value="@anio">@anio</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Período:</label>
        <select class="form-select" value="@periodoSeleccionado" @onchange="OnPeriodoChanged">
            <option value="total">Total histórico</option>
            <option value="semestre1">Semestre 1 (Ene-Jun)</option>
            <option value="semestre2">Semestre 2 (Jul-Dic)</option>
            @for (int i = 1; i <= 12; i++)
            {
                var mesValue = $"mes{i}";
                <option value="@mesValue">@CapitalizarMes(CultureInfo.GetCultureInfo("es-MX").DateTimeFormat.GetMonthName(i))</option>
            }
        </select>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button class="btn btn-primary w-100" @onclick="AplicarFiltros">Filtrar</button>
    </div>
</div>

@if (estaCargando)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-3">Cargando datos financieros...</p>
    </div>
}
else if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @mensajeError
        <br />
        <small>Revise la consola del navegador (F12) para más detalles.</small>
    </div>
}
else if (!hayDatos)
{
    <div class="alert alert-info text-center">
        No hay movimientos registrados todavía. Agrega ingresos o egresos para ver tu dashboard.
    </div>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card bg-dark text-white h-100">
                <div class="card-body">
                    <h5 class="card-title text-center">Ingresos vs Egresos</h5>
                    @if (datosBarras.Sum(x => x.Monto) > 0)
                    {
                        <RadzenChart Style="height: 300px;">
                            <RadzenColumnSeries TItem="TotalItem"
                                                Data="@datosBarras"
                                                CategoryProperty="Categoria"
                                                ValueProperty="Monto"
                                                Title="Monto Total"
                                                Fills="@paletaColoresBarras">
                                <TooltipTemplate Context="data">
                                    <div style="padding: 4px 8px;">
                                        <div>@data.Categoria</div>
                                        <div><strong>@data.Monto.ToString("C0", CultureInfo.GetCultureInfo("es-MX"))</strong></div>
                                        <div>@((data.Monto / datosBarras.Sum(x => x.Monto) * 100).ToString("F1"))%</div>
                                    </div>
                                </TooltipTemplate>
                            </RadzenColumnSeries>
                            <RadzenColumnOptions Radius="5" />
                            <RadzenCategoryAxis Padding="20" />
                            <RadzenValueAxis Min="0" Formatter="@FormatearMonedaEje">
                                <RadzenGridLines Visible="true" />
                            </RadzenValueAxis>
                            <RadzenChartTooltipOptions Shared="false" />
                            <RadzenLegend Visible="false" />
                        </RadzenChart>
                    }
                    else
                    {
                        <p class="text-center text-muted py-5">Sin datos para el período seleccionado</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card bg-dark text-white h-100">
                <div class="card-body">
                    <h5 class="card-title text-center">Proporción Ingresos - Egresos</h5>
                    @if (datosPastelTotal.Sum(x => x.Monto) > 0)
                    {
                        <RadzenChart Style="height: 300px;">
                            <RadzenPieSeries TItem="TotalItem"
                                             Data="@datosPastelTotal"
                                             CategoryProperty="Categoria"
                                             ValueProperty="Monto"
                                             Fills="@paletaColoresBarras">
                                <TooltipTemplate Context="data">
                                    <div style="padding: 4px 8px;">
                                        <div>@data.Categoria</div>
                                        <div><strong>@data.Monto.ToString("C0", CultureInfo.GetCultureInfo("es-MX"))</strong></div>
                                        <div>@((data.Monto / datosPastelTotal.Sum(x => x.Monto) * 100).ToString("F1"))%</div>
                                    </div>
                                </TooltipTemplate>
                            </RadzenPieSeries>
                            <RadzenChartTooltipOptions Shared="false" />
                        </RadzenChart>
                    }
                    else
                    {
                        <p class="text-center text-muted py-5">Sin datos para el período seleccionado</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card bg-dark text-white h-100">
                <div class="card-body">
                    <h5 class="card-title text-center">Ingresos por Categoría</h5>
                    @if (datosIngresosCategoria.Any())
                    {
                        <RadzenChart Style="height: 300px;">
                            <RadzenPieSeries TItem="CategoriaItem"
                                             Data="@datosIngresosCategoria"
                                             CategoryProperty="Categoria"
                                             ValueProperty="Monto">
                                <TooltipTemplate Context="data">
                                    <div style="padding: 4px 8px;">
                                        <div>@data.Categoria</div>
                                        <div><strong>@data.Monto.ToString("C0", CultureInfo.GetCultureInfo("es-MX"))</strong></div>
                                        <div>@((data.Monto / datosIngresosCategoria.Sum(x => x.Monto) * 100).ToString("F1"))%</div>
                                    </div>
                                </TooltipTemplate>
                            </RadzenPieSeries>
                            <RadzenChartTooltipOptions Shared="false" />
                        </RadzenChart>
                    }
                    else
                    {
                        <p class="text-center text-muted py-5">Sin ingresos en el período seleccionado</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card bg-dark text-white h-100">
                <div class="card-body">
                    <h5 class="card-title text-center">Egresos por Categoría</h5>
                    @if (datosEgresosCategoria.Any())
                    {
                        <RadzenChart Style="height: 300px;">
                            <RadzenPieSeries TItem="CategoriaItem"
                                             Data="@datosEgresosCategoria"
                                             CategoryProperty="Categoria"
                                             ValueProperty="Monto">
                                <TooltipTemplate Context="data">
                                    <div style="padding: 4px 8px;">
                                        <div>@data.Categoria</div>
                                        <div><strong>@data.Monto.ToString("C0", CultureInfo.GetCultureInfo("es-MX"))</strong></div>
                                        <div>@((data.Monto / datosEgresosCategoria.Sum(x => x.Monto) * 100).ToString("F1"))%</div>
                                    </div>
                                </TooltipTemplate>
                            </RadzenPieSeries>
                            <RadzenChartTooltipOptions Shared="false" />
                        </RadzenChart>
                    }
                    else
                    {
                        <p class="text-center text-muted py-5">Sin egresos en el período seleccionado</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <div class="card bg-dark text-white">
                <div class="card-body">
                    <h5 class="card-title text-center">Evolución de Gastos</h5>
                    @if (datosLinea.Any(d => d.Gasto > 0))
                    {
                        <RadzenChart Style="height: 300px;">
                            <RadzenLineSeries TItem="GastoMensual"
                                            Data="@datosLinea"
                                            CategoryProperty="Mes"
                                            ValueProperty="Gasto"
                                            Title="Gastos"
                                            Stroke="#fd7e14"
                                            StrokeWidth="2.8">
                                <RadzenMarkers MarkerType="MarkerType.Circle" Size="5" />
                            </RadzenLineSeries>
                            <RadzenCategoryAxis Padding="20" />
                            <RadzenValueAxis Formatter="@FormatearMonedaEje">
                                <RadzenGridLines Visible="true" />
                            </RadzenValueAxis>
                            <RadzenChartTooltipOptions Shared="true" />
                        </RadzenChart>
                    }
                    else
                    {
                        <p class="text-center text-muted py-5">Sin gastos registrados en el período seleccionado</p>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DatosApp? datos;
    private List<int> aniosDisponibles = new();
    private string anioSeleccionado = "todos";
    private string periodoSeleccionado = "total";
    private string? mensajeError;
    private bool estaCargando = true;
    private bool hayDatos;

    private List<TotalItem> datosBarras = new();
    private List<TotalItem> datosPastelTotal = new();
    private List<CategoriaItem> datosIngresosCategoria = new();
    private List<CategoriaItem> datosEgresosCategoria = new();
    private List<GastoMensual> datosLinea = new();

    private readonly string[] paletaColoresBarras = new string[] { "#28a745", "#dc3545" };

    // Categorías con menos de este % del total se agrupan en "Diversos" en los
    // pasteles de categoría, para que no queden rebanadas ilegibles. Ajustable
    // entre 10 y 15 según qué tan agresivo quieras el agrupamiento.
    private const double UmbralAgrupacionCategoria = 10.0;

    private string FormatearMonedaEje(object value)
    {
        if (value is double numero)
        {
            return numero.ToString("C0", CultureInfo.GetCultureInfo("es-MX"));
        }
        if (value is decimal numeroDecimal)
        {
            return numeroDecimal.ToString("C0", CultureInfo.GetCultureInfo("es-MX"));
        }
        return value?.ToString() ?? string.Empty;
    }

    private string CapitalizarMes(string mes)
    {
        if (string.IsNullOrEmpty(mes)) return mes;
        return char.ToUpper(mes[0]) + mes.Substring(1);
    }

    protected override async Task OnInitializedAsync()
    {
        estaCargando = true;
        try
        {
            datos = await ArchivoService.CargarAsync();

            hayDatos = datos.Movimientos.Any(m =>
                !string.IsNullOrWhiteSpace(m.Categoria) && m.Categoria != "Transferencia" && !DeudaCalculatorService.CategoriasDeuda.Contains(m.Categoria));

            if (hayDatos)
            {
                aniosDisponibles = datos.Movimientos
                    .Where(m => !string.IsNullOrWhiteSpace(m.Categoria) && m.Categoria != "Transferencia" && !DeudaCalculatorService.CategoriasDeuda.Contains(m.Categoria))
                    .Select(m => m.FechaOcurrido.Year)
                    .Distinct()
                    .OrderBy(a => a)
                    .ToList();

                CalcularMetricas();
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar datos: {ex.Message}";
            Console.WriteLine($"Excepción en OnInitializedAsync: {ex}");
        }
        finally
        {
            estaCargando = false;
        }
    }

    private void OnAnioChanged(ChangeEventArgs e)
    {
        anioSeleccionado = e.Value?.ToString() ?? "todos";
    }

    private void OnPeriodoChanged(ChangeEventArgs e)
    {
        periodoSeleccionado = e.Value?.ToString() ?? "total";
    }

    private void AplicarFiltros()
    {
        try
        {
            mensajeError = null;
            CalcularMetricas();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al aplicar filtros: {ex.Message}";
            Console.WriteLine($"Excepción en AplicarFiltros: {ex}");
        }
    }

    private void CalcularMetricas()
    {
        if (datos?.Movimientos == null)
        {
            LimpiarDatos();
            return;
        }

        var movimientos = datos.Movimientos
            .Where(m => !string.IsNullOrWhiteSpace(m.Categoria) && m.Categoria != "Transferencia" && !DeudaCalculatorService.CategoriasDeuda.Contains(m.Categoria))
            .ToList();

        if (!movimientos.Any())
        {
            LimpiarDatos();
            return;
        }

        if (anioSeleccionado != "todos" && int.TryParse(anioSeleccionado, out int anioParsed))
        {
            movimientos = movimientos.Where(m => m.FechaOcurrido.Year == anioParsed).ToList();
        }

        if (periodoSeleccionado != "total")
        {
            if (periodoSeleccionado == "semestre1")
                movimientos = movimientos.Where(m => m.FechaOcurrido.Month <= 6).ToList();
            else if (periodoSeleccionado == "semestre2")
                movimientos = movimientos.Where(m => m.FechaOcurrido.Month >= 7).ToList();
            else if (periodoSeleccionado.StartsWith("mes") && int.TryParse(periodoSeleccionado.AsSpan(3), out int mes))
            {
                movimientos = movimientos.Where(m => m.FechaOcurrido.Month == mes).ToList();
            }
        }

        if (!movimientos.Any())
        {
            LimpiarDatos();
            return;
        }

        decimal totalIngresos = movimientos.Where(m => m.Tipo == "Ingreso").Sum(m => m.Monto);
        decimal totalEgresos = movimientos.Where(m => m.Tipo == "Egreso").Sum(m => m.Monto);

        datosBarras = new List<TotalItem>
        {
            new() { Categoria = "Ingresos", Monto = (double)totalIngresos },
            new() { Categoria = "Egresos", Monto = (double)totalEgresos }
        };

        datosPastelTotal = datosBarras
            .Select(x => new TotalItem { Categoria = x.Categoria, Monto = x.Monto })
            .ToList();

        var ingresosPorCategoria = movimientos
            .Where(m => m.Tipo == "Ingreso")
            .GroupBy(m => m.Categoria)
            .Select(g => new CategoriaItem { Categoria = g.Key, Monto = (double)g.Sum(m => m.Monto) })
            .OrderByDescending(x => x.Monto)
            .ToList();
        datosIngresosCategoria = AgruparCategoriasMenores(ingresosPorCategoria);

        var egresosPorCategoria = movimientos
            .Where(m => m.Tipo == "Egreso")
            .GroupBy(m => m.Categoria)
            .Select(g => new CategoriaItem { Categoria = g.Key, Monto = (double)g.Sum(m => m.Monto) })
            .OrderByDescending(x => x.Monto)
            .ToList();
        datosEgresosCategoria = AgruparCategoriasMenores(egresosPorCategoria);

        ConstruirLineaGastos(movimientos);
    }

    private List<CategoriaItem> AgruparCategoriasMenores(List<CategoriaItem> items)
    {
        double total = items.Sum(x => x.Monto);
        if (total <= 0) return items;

        var principales = items.Where(x => (x.Monto / total * 100) >= UmbralAgrupacionCategoria).ToList();
        var menores = items.Where(x => (x.Monto / total * 100) < UmbralAgrupacionCategoria).ToList();

        if (menores.Count >= 2)
        {
            principales.Add(new CategoriaItem { Categoria = "Diversos", Monto = menores.Sum(x => x.Monto) });
        }
        else
        {
            principales.AddRange(menores);
        }

        return principales.OrderByDescending(x => x.Monto).ToList();
    }

    private void ConstruirLineaGastos(List<Movimiento> movimientos)
    {
        var lineData = new List<GastoMensual>();
        var cultura = CultureInfo.GetCultureInfo("es-MX");

        if (anioSeleccionado != "todos" && int.TryParse(anioSeleccionado, out int anio))
        {
            // Año específico: siempre 12 meses de ese año, sin importar si
            // además hay un filtro de mes/semestre aplicado (un solo año no
            // sufre el problema de huecos, porque no hay nada que comparar).
            for (int mes = 1; mes <= 12; mes++)
            {
                decimal gasto = movimientos
                    .Where(m => m.Tipo == "Egreso" && m.FechaOcurrido.Year == anio && m.FechaOcurrido.Month == mes)
                    .Sum(m => m.Monto);
                lineData.Add(new GastoMensual
                {
                    Mes = CapitalizarMes(cultura.DateTimeFormat.GetAbbreviatedMonthName(mes)),
                    Gasto = (double)gasto
                });
            }
        }
        else if (periodoSeleccionado != "total")
        {
            // "Todos" los años + un mes o semestre específico: en vez de recorrer
            // mes a mes (lo cual dejaba huecos en cero para los meses fuera del
            // filtro), se compara ese mismo período año contra año — un punto
            // por cada año que tenga datos.
            var aniosConDatos = movimientos.Select(m => m.FechaOcurrido.Year).Distinct().OrderBy(a => a).ToList();

            string etiquetaPeriodo = periodoSeleccionado switch
            {
                "semestre1" => "Sem1",
                "semestre2" => "Sem2",
                _ when periodoSeleccionado.StartsWith("mes") && int.TryParse(periodoSeleccionado.AsSpan(3), out int mesFiltro)
                    => CapitalizarMes(cultura.DateTimeFormat.GetAbbreviatedMonthName(mesFiltro)),
                _ => ""
            };

            foreach (var anioConDatos in aniosConDatos)
            {
                decimal gasto = movimientos
                    .Where(m => m.Tipo == "Egreso" && m.FechaOcurrido.Year == anioConDatos)
                    .Sum(m => m.Monto);
                lineData.Add(new GastoMensual
                {
                    Mes = $"{etiquetaPeriodo} {anioConDatos}",
                    Gasto = (double)gasto
                });
            }
        }
        else
        {
            // Total histórico, todos los años: línea mes a mes continua, sin huecos.
            var fechas = movimientos.Select(m => m.FechaOcurrido).ToList();
            var primera = fechas.Min();
            var ultima = fechas.Max();
            var fecha = new DateTime(primera.Year, primera.Month, 1);
            string formato = (primera.Year == ultima.Year) ? "MMM" : "MMM yy";

            int maxIteraciones = 360;
            int iteraciones = 0;

            while (fecha <= ultima && iteraciones < maxIteraciones)
            {
                decimal gasto = movimientos
                    .Where(m => m.Tipo == "Egreso" && m.FechaOcurrido.Year == fecha.Year && m.FechaOcurrido.Month == fecha.Month)
                    .Sum(m => m.Monto);
                lineData.Add(new GastoMensual
                {
                    Mes = CapitalizarMes(fecha.ToString(formato, cultura)),
                    Gasto = (double)gasto
                });
                fecha = fecha.AddMonths(1);
                iteraciones++;
            }
        }
        datosLinea = lineData;
    }

    private void LimpiarDatos()
    {
        datosBarras = new List<TotalItem>();
        datosPastelTotal = new List<TotalItem>();
        datosIngresosCategoria = new List<CategoriaItem>();
        datosEgresosCategoria = new List<CategoriaItem>();
        datosLinea = new List<GastoMensual>();
    }
}