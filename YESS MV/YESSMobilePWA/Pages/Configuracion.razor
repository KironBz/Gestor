@page "/configuracion"
@using YESSMobilePWA.Models
@using YESSMobilePWA.Services
@using System.Text.Json
@inject ArchivoService ArchivoService
@inject IJSRuntime JS

<h3>Configuración</h3>

<ul class="nav nav-tabs">
    <li class="nav-item">
        <a class="nav-link @(tabActiva == "cuentas" ? "active" : "")" @onclick='() => tabActiva = "cuentas"'>Cuentas</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(tabActiva == "categorias" ? "active" : "")" @onclick='() => tabActiva = "categorias"'>Categorías</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(tabActiva == "personas" ? "active" : "")" @onclick='() => tabActiva = "personas"'>Personas</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(tabActiva == "importar" ? "active" : "")" @onclick='() => tabActiva = "importar"'>Opciones</a>
    </li>
</ul>

<div class="mt-3">
    @* ================== CUENTAS ================== *@
    @if (tabActiva == "cuentas")
    {
        <h5>Cuentas</h5>
        <div class="d-none d-md-block">
            <table class="table table-dark table-striped">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Visibilidad</th>
                        <th>Saldo actual</th>
                        <th>Color</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cuenta in cuentas)
                    {
                        <tr>
                            <td>@cuenta.Nombre</td>
                            <td>@cuenta.Visibilidad</td>
                            <td>@cuenta.SaldoActual.ToString("C")</td>
                            <td><div style="width:30px; height:30px; background-color:@cuenta.Color; border:1px solid white;"></div></td>
                            <td>
                                <button class="btn btn-sm btn-warning" @onclick="() => AbrirModalEditarCuenta(cuenta)">Editar</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => EliminarCuenta(cuenta)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-block d-md-none">
            @foreach (var cuenta in cuentas)
            {
                <div class="card bg-dark text-white mb-3">
                    <div class="card-body">
                        <h6 class="card-title">@cuenta.Nombre</h6>
                        <p>Visibilidad: @cuenta.Visibilidad</p>
                        <p>Saldo actual: @cuenta.SaldoActual.ToString("C")</p>
                        <p>Color: <span style="display:inline-block; width:20px; height:20px; background-color:@cuenta.Color;"></span></p>
                        <button class="btn btn-sm btn-warning" @onclick="() => AbrirModalEditarCuenta(cuenta)">Editar</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => EliminarCuenta(cuenta)">Eliminar</button>
                    </div>
                </div>
            }
        </div>
        <button class="btn btn-primary mt-2" @onclick="AbrirModalNuevaCuenta">+ Agregar cuenta</button>
    }

    @* ================== CATEGORÍAS ================== *@
    else if (tabActiva == "categorias")
    {
        <h5>Categorías</h5>
        <div class="d-none d-md-block">
            <table class="table table-dark table-striped">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Tipo permitido</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var categoria in categorias)
                    {
                        <tr>
                            <td>@categoria.Nombre</td>
                            <td>@categoria.TipoPermitido</td>
                            <td>
                                <button class="btn btn-sm btn-warning" @onclick="() => AbrirModalEditarCategoria(categoria)">Editar</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => EliminarCategoria(categoria)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-block d-md-none">
            @foreach (var categoria in categorias)
            {
                <div class="card bg-dark text-white mb-3">
                    <div class="card-body">
                        <h6 class="card-title">@categoria.Nombre</h6>
                        <p>Tipo permitido: @categoria.TipoPermitido</p>
                        <button class="btn btn-sm btn-warning" @onclick="() => AbrirModalEditarCategoria(categoria)">Editar</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => EliminarCategoria(categoria)">Eliminar</button>
                    </div>
                </div>
            }
        </div>
        <button class="btn btn-primary mt-2" @onclick="AbrirModalNuevaCategoria">+ Agregar categoría</button>
    }

    @* ================== PERSONAS ================== *@
    else if (tabActiva == "personas")
    {
        <h5>Personas</h5>
        <div class="d-none d-md-block">
            <table class="table table-dark table-striped">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var persona in personas)
                    {
                        <tr>
                            <td>@persona.Nombre</td>
                            <td>@persona.Tipo</td>
                            <td>
                                <button class="btn btn-sm btn-warning" @onclick="() => AbrirModalEditarPersona(persona)">Editar</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => EliminarPersona(persona)">Eliminar</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-block d-md-none">
            @foreach (var persona in personas)
            {
                <div class="card bg-dark text-white mb-3">
                    <div class="card-body">
                        <h6 class="card-title">@persona.Nombre</h6>
                        <p>Tipo: @persona.Tipo</p>
                        <button class="btn btn-sm btn-warning" @onclick="() => AbrirModalEditarPersona(persona)">Editar</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => EliminarPersona(persona)">Eliminar</button>
                    </div>
                </div>
            }
        </div>
        <button class="btn btn-primary mt-2" @onclick="AbrirModalNuevaPersona">+ Agregar persona</button>
    }

    @* ================== IMPORTAR/EXPORTAR ================== *@
    else if (tabActiva == "importar")
    {
        <h5>Importar/Exportar datos</h5>
        <p>Selecciona un archivo JSON para importar (sobrescribe los datos actuales).</p>
        <div class="mb-3">
            <input type="file" id="fileInput" accept=".json" class="form-control" />
        </div>
        <button class="btn btn-primary" @onclick="ImportarArchivo">Importar</button>
        <button class="btn btn-secondary" @onclick="ExportarArchivo">Exportar datos (local)</button>

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <div class="alert alert-info mt-3">@mensaje</div>
        }

        <hr class="my-4" />

        <h5>Respaldo en GitHub Gist (Nube)</h5>
        <p>Guarda automáticamente un respaldo en un Gist privado de GitHub.</p>
        <div class="mb-3">
            <label class="form-label">Token de acceso personal de GitHub</label>
            <input type="password" class="form-control" @bind="gitHubTokenInput" placeholder="ghp_xxxxxx" />
            <small class="form-text text-muted">Debe tener permiso "gist". Se guarda en localStorage.</small>
        </div>
        <button class="btn btn-success" @onclick="GuardarTokenGitHub" disabled="@string.IsNullOrEmpty(gitHubTokenInput)">Guardar token</button>
        <button class="btn btn-info mt-2" @onclick="SubirAGitHub" disabled="@(string.IsNullOrEmpty(datosCache?.GitHubToken))">Subir respaldo a GitHub</button>
        <button class="btn btn-secondary mt-2" @onclick="DescargarDesdeGitHub" disabled="@(string.IsNullOrEmpty(datosCache?.GitHubGistId))">Restaurar desde GitHub</button>
        @if (!string.IsNullOrEmpty(mensajeGitHub))
        {
            <div class="alert alert-info mt-3">@mensajeGitHub</div>
        }
    }
</div>

<!-- MODAL PARA CUENTA -->
@if (modalCuentaVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content bg-dark text-white">
                <div class="modal-header">
                    <h5 class="modal-title">@(cuentaEditando == null ? "Nueva cuenta" : "Editar cuenta")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => modalCuentaVisible = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" @bind="cuentaFormulario.Nombre" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Visibilidad</label>
                        <select class="form-select" @bind="cuentaFormulario.Visibilidad">
                            <option value="Corriente">Corriente</option>
                            <option value="Oculto">Oculto</option>
                            <option value="Ajeno">Ajeno</option>
                            <option value="Transporte">Transporte</option>
                            <option value="Ahorro">Ahorro</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Saldo actual</label>
                        <input type="number" step="0.01" class="form-control" @bind="cuentaFormulario.NuevoSaldoActual" />
                        <small class="form-text text-muted">Ajusta aquí el dinero real que tienes en esta cuenta. El sistema recalculará automáticamente el saldo inicial.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Color</label>
                        <input type="color" class="form-control" @bind="cuentaFormulario.Color" />
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-3 pb-3">
                        <button type="button" class="btn btn-secondary" @onclick="() => modalCuentaVisible = false">Cancelar</button>
                        <button type="button" class="btn btn-primary" @onclick="GuardarCuentaModal">Guardar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL PARA CATEGORÍA -->
@if (modalCategoriaVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content bg-dark text-white">
                <div class="modal-header">
                    <h5 class="modal-title">@(categoriaEditando == null ? "Nueva categoría" : "Editar categoría")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => modalCategoriaVisible = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" @bind="categoriaFormulario.Nombre" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo permitido</label>
                        <select class="form-select" @bind="categoriaFormulario.TipoPermitido">
                            <option value="Ingreso">Ingreso</option>
                            <option value="Egreso">Egreso</option>
                            <option value="Ambos">Ambos</option>
                        </select>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-3 pb-3">
                        <button type="button" class="btn btn-secondary" @onclick="() => modalCategoriaVisible = false">Cancelar</button>
                        <button type="button" class="btn btn-primary" @onclick="GuardarCategoriaModal">Guardar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL PARA PERSONA -->
@if (modalPersonaVisible)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content bg-dark text-white">
                <div class="modal-header">
                    <h5 class="modal-title">@(personaEditando == null ? "Nueva persona" : "Editar persona")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => modalPersonaVisible = false"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" class="form-control" @bind="personaFormulario.Nombre" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo</label>
                        <select class="form-select" @bind="personaFormulario.Tipo">
                            <option value="Deudor">Deudor</option>
                            <option value="Acreedor">Acreedor</option>
                            <option value="Ambos">Ambos</option>
                            <option value="Ninguno">Ninguno</option>
                        </select>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-3 pb-3">
                        <button type="button" class="btn btn-secondary" @onclick="() => modalPersonaVisible = false">Cancelar</button>
                        <button type="button" class="btn btn-primary" @onclick="GuardarPersonaModal">Guardar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string tabActiva = "cuentas";
    private List<Cuenta> cuentas = new();
    private List<Categoria> categorias = new();
    private List<Persona> personas = new();
    private string mensaje = "";

    private bool modalCuentaVisible = false;
    private Cuenta? cuentaEditando = null;
    private CuentaFormula cuentaFormulario = new();

    private bool modalCategoriaVisible = false;
    private Categoria? categoriaEditando = null;
    private CategoriaFormula categoriaFormulario = new();

    private bool modalPersonaVisible = false;
    private Persona? personaEditando = null;
    private PersonaFormula personaFormulario = new();

    private string gitHubTokenInput = "";
    private string mensajeGitHub = "";
    private DatosApp? datosCache;

    private class CuentaFormula
    {
        public string Nombre { get; set; } = "";
        public string Visibilidad { get; set; } = "Corriente";
        public decimal NuevoSaldoActual { get; set; }
        public string Color { get; set; } = "#FFFFFF";
    }
    private class CategoriaFormula
    {
        public string Nombre { get; set; } = "";
        public string TipoPermitido { get; set; } = "Ambos";
    }
    private class PersonaFormula
    {
        public string Nombre { get; set; } = "";
        public string Tipo { get; set; } = "Ninguno";
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
        gitHubTokenInput = datosCache?.GitHubToken ?? "";
    }

    private async Task CargarDatos()
    {
        datosCache = await ArchivoService.CargarAsync();
        cuentas = datosCache.Cuentas.ToList();
        categorias = datosCache.Categorias.ToList();
        personas = datosCache.Personas.ToList();
        CalcularSaldosActuales();
        StateHasChanged();
    }

    private void CalcularSaldosActuales()
    {
        if (datosCache == null) return;
        foreach (var cuenta in cuentas)
        {
            cuenta.SaldoActual = cuenta.SaldoInicial;
        }
        foreach (var mov in datosCache.Movimientos)
        {
            var cuenta = cuentas.FirstOrDefault(c => c.Id == mov.CuentaId);
            if (cuenta == null) continue;
            if (mov.Tipo == "Ingreso")
                cuenta.SaldoActual += mov.Monto;
            else if (mov.Tipo == "Egreso")
                cuenta.SaldoActual -= mov.Monto;
        }
    }

    private class GistArchivo
    {
        [System.Text.Json.Serialization.JsonPropertyName("content")]
        public string Content { get; set; } = "";
    }

    private class GistRespuesta
    {
        [System.Text.Json.Serialization.JsonPropertyName("id")]
        public string Id { get; set; } = "";

        [System.Text.Json.Serialization.JsonPropertyName("files")]
        public Dictionary<string, GistArchivo> Files { get; set; } = new();
    }

    private void AbrirModalNuevaCuenta()
    {
        cuentaEditando = null;
        cuentaFormulario = new CuentaFormula();
        modalCuentaVisible = true;
    }

    private void AbrirModalEditarCuenta(Cuenta cuenta)
    {
        cuentaEditando = cuenta;
        cuentaFormulario = new CuentaFormula
        {
            Nombre = cuenta.Nombre,
            Visibilidad = cuenta.Visibilidad,
            NuevoSaldoActual = cuenta.SaldoActual,
            Color = cuenta.Color
        };
        modalCuentaVisible = true;
    }

    private async Task GuardarCuentaModal()
    {
        if (string.IsNullOrWhiteSpace(cuentaFormulario.Nombre))
        {
            await JS.InvokeVoidAsync("alert", "El nombre de la cuenta no puede estar vacío.");
            return;
        }
        var nombreNormalizado = cuentaFormulario.Nombre.Trim();
        var duplicado = cuentas.Any(c => c.Id != (cuentaEditando?.Id ?? "") &&
                                           c.Nombre.Equals(nombreNormalizado, StringComparison.OrdinalIgnoreCase));
        if (duplicado)
        {
            await JS.InvokeVoidAsync("alert", "Ya existe una cuenta con ese nombre.");
            return;
        }
        if (datosCache == null) return;

        decimal netoMovimientos = 0;
        if (cuentaEditando != null)
        {
            netoMovimientos = datosCache.Movimientos
                .Where(m => m.CuentaId == cuentaEditando.Id)
                .Sum(m => m.Tipo == "Ingreso" ? m.Monto : -m.Monto);
        }
        decimal nuevoSaldoInicial = cuentaFormulario.NuevoSaldoActual - netoMovimientos;

        if (cuentaEditando == null)
        {
            var nueva = new Cuenta(nombreNormalizado, cuentaFormulario.Visibilidad, nuevoSaldoInicial);
            nueva.Color = cuentaFormulario.Color;
            nueva.SaldoActual = cuentaFormulario.NuevoSaldoActual;
            cuentas.Add(nueva);
        }
        else
        {
            cuentaEditando.Nombre = nombreNormalizado;
            cuentaEditando.Visibilidad = cuentaFormulario.Visibilidad;
            cuentaEditando.SaldoInicial = nuevoSaldoInicial;
            cuentaEditando.Color = cuentaFormulario.Color;
            cuentaEditando.SaldoActual = cuentaFormulario.NuevoSaldoActual;
        }
        modalCuentaVisible = false;
        await PersistirDatos();
    }

    private async Task EliminarCuenta(Cuenta cuenta)
    {
        if (datosCache != null && datosCache.Movimientos.Any(m => m.CuentaId == cuenta.Id))
        {
            await JS.InvokeVoidAsync("alert", $"No se puede eliminar la cuenta '{cuenta.Nombre}' porque tiene movimientos asociados.");
            return;
        }
        if (await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la cuenta '{cuenta.Nombre}'?"))
        {
            cuentas.Remove(cuenta);
            await PersistirDatos();
        }
    }

    private void AbrirModalNuevaCategoria()
    {
        categoriaEditando = null;
        categoriaFormulario = new CategoriaFormula();
        modalCategoriaVisible = true;
    }

    private void AbrirModalEditarCategoria(Categoria categoria)
    {
        categoriaEditando = categoria;
        categoriaFormulario = new CategoriaFormula
        {
            Nombre = categoria.Nombre,
            TipoPermitido = categoria.TipoPermitido
        };
        modalCategoriaVisible = true;
    }

    private async Task GuardarCategoriaModal()
    {
        if (string.IsNullOrWhiteSpace(categoriaFormulario.Nombre))
        {
            await JS.InvokeVoidAsync("alert", "El nombre de la categoría no puede estar vacío.");
            return;
        }
        var nombreNormalizado = categoriaFormulario.Nombre.Trim();
        var duplicado = categorias.Any(c => c.Id != (categoriaEditando?.Id ?? "") &&
                                             c.Nombre.Equals(nombreNormalizado, StringComparison.OrdinalIgnoreCase));
        if (duplicado)
        {
            await JS.InvokeVoidAsync("alert", "Ya existe una categoría con ese nombre.");
            return;
        }
        if (categoriaEditando == null)
        {
            categorias.Add(new Categoria(nombreNormalizado, categoriaFormulario.TipoPermitido));
        }
        else
        {
            categoriaEditando.Nombre = nombreNormalizado;
            categoriaEditando.TipoPermitido = categoriaFormulario.TipoPermitido;
        }
        modalCategoriaVisible = false;
        await PersistirDatos();
    }

    private async Task EliminarCategoria(Categoria categoria)
    {
        if (datosCache != null && datosCache.Movimientos.Any(m => m.CategoriaId == categoria.Id))
        {
            await JS.InvokeVoidAsync("alert", $"No se puede eliminar la categoría '{categoria.Nombre}' porque tiene movimientos asociados.");
            return;
        }
        if (await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la categoría '{categoria.Nombre}'?"))
        {
            categorias.Remove(categoria);
            await PersistirDatos();
        }
    }

    private void AbrirModalNuevaPersona()
    {
        personaEditando = null;
        personaFormulario = new PersonaFormula();
        modalPersonaVisible = true;
    }

    private void AbrirModalEditarPersona(Persona persona)
    {
        personaEditando = persona;
        personaFormulario = new PersonaFormula
        {
            Nombre = persona.Nombre,
            Tipo = persona.Tipo
        };
        modalPersonaVisible = true;
    }

    private async Task GuardarPersonaModal()
    {
        if (string.IsNullOrWhiteSpace(personaFormulario.Nombre))
        {
            await JS.InvokeVoidAsync("alert", "El nombre de la persona no puede estar vacío.");
            return;
        }
        var nombreNormalizado = personaFormulario.Nombre.Trim();
        var duplicado = personas.Any(p => p.Id != (personaEditando?.Id ?? "") &&
                                           p.Nombre.Equals(nombreNormalizado, StringComparison.OrdinalIgnoreCase));
        if (duplicado)
        {
            await JS.InvokeVoidAsync("alert", "Ya existe una persona con ese nombre.");
            return;
        }
        if (personaEditando == null)
        {
            personas.Add(new Persona(nombreNormalizado, personaFormulario.Tipo));
        }
        else
        {
            personaEditando.Nombre = nombreNormalizado;
            personaEditando.Tipo = personaFormulario.Tipo;
        }
        modalPersonaVisible = false;
        await PersistirDatos();
    }

    private async Task EliminarPersona(Persona persona)
    {
        if (datosCache != null && datosCache.Movimientos.Any(m => m.PersonaId == persona.Id))
        {
            await JS.InvokeVoidAsync("alert", $"No se puede eliminar la persona '{persona.Nombre}' porque tiene movimientos asociados.");
            return;
        }
        if (await JS.InvokeAsync<bool>("confirm", $"¿Eliminar a '{persona.Nombre}'?"))
        {
            personas.Remove(persona);
            await PersistirDatos();
        }
    }

    private async Task PersistirDatos()
    {
        if (datosCache == null) return;
        datosCache.Cuentas = cuentas;
        datosCache.Categorias = categorias;
        datosCache.Personas = personas;
        await ArchivoService.GuardarAsync(datosCache);
        await CargarDatos();
        mensaje = "Cambios guardados.";
        StateHasChanged();
    }

    private async Task ImportarArchivo()
    {
        var contenido = await JS.InvokeAsync<string>("getFileContent", "fileInput");
        if (string.IsNullOrEmpty(contenido))
        {
            mensaje = "Selecciona un archivo JSON.";
            return;
        }
        try
        {
            var datos = JsonSerializer.Deserialize<DatosApp>(contenido);
            if (datos == null) throw new Exception("Archivo inválido");
            await ArchivoService.GuardarAsync(datos);
            await CargarDatos();
            mensaje = "Importación exitosa.";
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
        }
        StateHasChanged();
    }

    private async Task ExportarArchivo()
    {
        if (datosCache == null) return;
        datosCache.UltimaExportacion = DateTime.Now;
        await PersistirDatos();
        var json = JsonSerializer.Serialize(datosCache, new JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("downloadFile", "yes_gestor_data.json", json);
        mensaje = "Exportación local completada. El recordatorio de backup se ha reiniciado.";
    }

    private async Task GuardarTokenGitHub()
    {
        if (datosCache == null) return;
        datosCache.GitHubToken = gitHubTokenInput;
        await PersistirDatos();
        mensajeGitHub = "Token guardado correctamente.";
    }

    private async Task SubirAGitHub()
    {
        if (datosCache == null) return;
        if (string.IsNullOrEmpty(datosCache.GitHubToken))
        {
            mensajeGitHub = "Primero guarda tu token de GitHub.";
            return;
        }

        var datosParaGist = new
        {
            version = datosCache.Version,
            ultimaExportacion = datosCache.UltimaExportacion,
            movimientos = datosCache.Movimientos,
            cuentas = datosCache.Cuentas,
            categorias = datosCache.Categorias,
            personas = datosCache.Personas,
            metas = datosCache.Metas
        };

        var json = JsonSerializer.Serialize(datosParaGist, new JsonSerializerOptions { WriteIndented = true });

        try
        {
            using var http = new HttpClient();
            http.DefaultRequestHeaders.Add("Authorization", $"token {datosCache.GitHubToken}");
            http.DefaultRequestHeaders.Add("User-Agent", "YESSMobilePWA");

            if (string.IsNullOrEmpty(datosCache.GitHubGistId))
            {
                var gist = new
                {
                    description = $"Backup de YESSMobilePWA - {DateTime.Now:yyyy-MM-dd HH:mm:ss}",
                    @public = false,
                    files = new Dictionary<string, object>
                    {
                        ["yes_gestor_data.json"] = new { content = json }
                    }
                };
                var content = new StringContent(JsonSerializer.Serialize(gist), System.Text.Encoding.UTF8, "application/json");
                var response = await http.PostAsync("https://api.github.com/gists", content);
                var responseJson = await response.Content.ReadAsStringAsync();

                if (response.IsSuccessStatusCode)
                {
                    var gistObj = JsonSerializer.Deserialize<GistRespuesta>(responseJson);
                    if (gistObj != null && !string.IsNullOrEmpty(gistObj.Id))
                    {
                        datosCache.GitHubGistId = gistObj.Id;
                        datosCache.UltimaExportacion = DateTime.Now;
                        await PersistirDatos();
                        mensajeGitHub = $"Respaldo creado en Gist. ID: {datosCache.GitHubGistId}. Recordatorio de backup reiniciado.";
                    }
                    else
                    {
                        mensajeGitHub = "Gist creado, pero no se pudo leer su ID en la respuesta.";
                    }
                }
                else
                {
                    mensajeGitHub = $"Error al crear Gist: {response.StatusCode} - {responseJson}";
                }
            }
            else
            {
                var update = new
                {
                    files = new Dictionary<string, object>
                    {
                        ["yes_gestor_data.json"] = new { content = json }
                    }
                };
                var content = new StringContent(JsonSerializer.Serialize(update), System.Text.Encoding.UTF8, "application/json");
                var response = await http.PatchAsync($"https://api.github.com/gists/{datosCache.GitHubGistId}", content);
                if (response.IsSuccessStatusCode)
                {
                    datosCache.UltimaExportacion = DateTime.Now;
                    await PersistirDatos();
                    mensajeGitHub = "Respaldo actualizado correctamente. Recordatorio de backup reiniciado.";
                }
                else
                {
                    var error = await response.Content.ReadAsStringAsync();
                    mensajeGitHub = $"Error al actualizar Gist: {response.StatusCode} - {error}";
                }
            }
        }
        catch (Exception ex)
        {
            mensajeGitHub = $"Excepción: {ex.Message}";
        }
    }

    private async Task DescargarDesdeGitHub()
    {
        if (datosCache == null || string.IsNullOrEmpty(datosCache.GitHubGistId))
        {
            mensajeGitHub = "No hay Gist asociado. Primero sube un respaldo.";
            return;
        }
        try
        {
            using var http = new HttpClient();
            http.DefaultRequestHeaders.Add("User-Agent", "YESSMobilePWA");
            if (!string.IsNullOrEmpty(datosCache.GitHubToken))
            {
                http.DefaultRequestHeaders.Add("Authorization", $"token {datosCache.GitHubToken}");
            }

            var response = await http.GetAsync($"https://api.github.com/gists/{datosCache.GitHubGistId}");
            if (response.IsSuccessStatusCode)
            {
                var responseJson = await response.Content.ReadAsStringAsync();
                var gist = JsonSerializer.Deserialize<GistRespuesta>(responseJson);

                if (gist != null && gist.Files.TryGetValue("yes_gestor_data.json", out var archivo))
                {
                    var nuevosDatos = JsonSerializer.Deserialize<DatosApp>(archivo.Content);
                    if (nuevosDatos != null)
                    {
                        var tokenActual = datosCache.GitHubToken;
                        var gistIdActual = datosCache.GitHubGistId;
                        nuevosDatos.GitHubToken = tokenActual;
                        nuevosDatos.GitHubGistId = gistIdActual;
                        nuevosDatos.UltimaExportacion = DateTime.Now;
                        datosCache = nuevosDatos;
                        await ArchivoService.GuardarAsync(datosCache);
                        await CargarDatos();
                        mensajeGitHub = "Datos restaurados desde GitHub. (Token y GistId locales conservados)";
                    }
                    else
                    {
                        mensajeGitHub = "El contenido del Gist no se pudo interpretar como datos válidos.";
                    }
                }
                else
                {
                    mensajeGitHub = "El Gist no contiene el archivo esperado 'yes_gestor_data.json'.";
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                mensajeGitHub = $"Error al descargar Gist: {response.StatusCode} - {error}";
            }
        }
        catch (Exception ex)
        {
            mensajeGitHub = $"Excepción: {ex.Message}";
        }
    }
}