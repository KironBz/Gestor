@inherits LayoutComponentBase
@using YESSMobilePWA.Services
@using YESSMobilePWA.Models
@inject ArchivoService ArchivoService
@inject IJSRuntime JS

<div class="page">
    <!-- Sidebar: solo visible en escritorio (md y superiores) -->
    <div class="sidebar d-none d-md-block">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4" style="padding-bottom: 6rem;">
            @* Banner de recordatorio de backup *@
            @if (mostrarBannerBackup)
            {
                <div class="alert alert-warning alert-dismissible fade show mb-3" role="alert">
                    <strong>📁 ¡Importante!</strong> Han pasado más de 7 días desde tu última exportación de datos.
                    <button class="btn btn-sm btn-primary ms-2" @onclick="ExportarAhora">Exportar ahora</button>
                    <button type="button" class="btn-close" @onclick="CerrarBanner" aria-label="Close"></button>
                </div>
            }
            @Body
        </article>
    </main>
</div>

<!-- Barra inferior para móvil (solo iconos con emojis) -->
<div class="bottom-nav d-md-none">
    <div class="bottom-nav-scroll">
        <NavLink class="nav-item" href="resumen"><span>🏠</span></NavLink>
        <NavLink class="nav-item" href="balance"><span>📊</span></NavLink>
        <NavLink class="nav-item" href="movimientos"><span>📋</span></NavLink>
        <NavLink class="nav-item" href="prestamos"><span>💳</span></NavLink>
        <NavLink class="nav-item" href="dashboard"><span>📈</span></NavLink>
        <NavLink class="nav-item" href="metas"><span>🎯</span></NavLink>
        <NavLink class="nav-item" href="configuracion"><span>⚙️</span></NavLink>
    </div>
</div>

@code {
    private bool mostrarBannerBackup = false;
    private DatosApp? datos;

    protected override async Task OnInitializedAsync()
    {
        await VerificarBackup();
    }

    private async Task VerificarBackup()
    {
        try
        {
            datos = await ArchivoService.CargarAsync();
            if (datos == null) return;

            if (datos.UltimaExportacion == null || (DateTime.Now - datos.UltimaExportacion.Value).Days >= 7)
            {
                mostrarBannerBackup = true;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al verificar backup: {ex.Message}");
        }
    }

    private async Task ExportarAhora()
    {
        if (datos == null) return;

        var json = System.Text.Json.JsonSerializer.Serialize(datos, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("downloadFile", $"backup_{DateTime.Now:yyyyMMdd_HHmmss}.json", json);
        datos.UltimaExportacion = DateTime.Now;
        await ArchivoService.GuardarAsync(datos);
        mostrarBannerBackup = false;
        StateHasChanged();

        await JS.InvokeVoidAsync("alert", "¡Exportación completada! Recuerda guardar el archivo en un lugar seguro.");
    }

    private void CerrarBanner()
    {
        mostrarBannerBackup = false;
        StateHasChanged();
    }
}